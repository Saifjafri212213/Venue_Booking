<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
  
  <!-- Welcome Banner -->
  <div class="bg-gradient-to-r from-brand-900 via-indigo-900 to-slate-900 rounded-3xl p-6 sm:p-10 text-white shadow-xl relative overflow-hidden">
    <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
      
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-brand-300 text-xs font-bold backdrop-blur-md">
          <i class="fa-solid fa-user-circle"></i> Organiser Workspace
        </div>
        <h1 class="font-heading font-extrabold text-2xl sm:text-4xl tracking-tight text-white">
          Welcome back, <%= user.name %>!
        </h1>
        <p class="text-xs sm:text-sm text-slate-300 max-w-lg leading-relaxed">
          <%= user.organization %> (<%= user.department %>). Manage your campus event reservations, verify booking passes, and book spaces with live conflict protection.
        </p>
      </div>

      <!-- Quick Actions -->
      <div class="flex flex-wrap items-center gap-3">
        <a href="/bookings/new" class="py-3 px-5 rounded-xl text-xs font-bold uppercase tracking-wider text-slate-900 bg-white hover:bg-slate-100 shadow-md transition-all hover:scale-105 flex items-center gap-2">
          <i class="fa-solid fa-calendar-plus text-brand-600"></i> Request Booking
        </a>
        <a href="/venues" class="py-3 px-5 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-brand-600 hover:bg-brand-500 shadow-md shadow-brand-500/30 transition-all hover:scale-105 flex items-center gap-2">
          <i class="fa-solid fa-compass"></i> Explore Venues
        </a>
      </div>

    </div>
  </div>

  <!-- Key Stat Cards -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
    
    <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between text-slate-500 text-xs font-bold mb-2">
        <span>Total Bookings</span>
        <i class="fa-solid fa-list-check text-slate-400"></i>
      </div>
      <div class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-heading"><%= stats.totalBookings %></div>
      <span class="text-[10px] text-slate-400 mt-1 block">Lifetime reservations</span>
    </div>

    <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between text-amber-600 text-xs font-bold mb-2">
        <span>Pending Approval</span>
        <i class="fa-solid fa-hourglass-half text-amber-500"></i>
      </div>
      <div class="text-2xl sm:text-3xl font-extrabold text-amber-600 font-heading"><%= stats.pendingCount %></div>
      <span class="text-[10px] text-slate-400 mt-1 block">Under admin review</span>
    </div>

    <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between text-indigo-600 text-xs font-bold mb-2">
        <span>Approved Upcoming</span>
        <i class="fa-solid fa-calendar-check text-indigo-500"></i>
      </div>
      <div class="text-2xl sm:text-3xl font-extrabold text-indigo-600 font-heading"><%= stats.approvedCount %></div>
      <span class="text-[10px] text-slate-400 mt-1 block">Confirmed event passes</span>
    </div>

    <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between text-emerald-600 text-xs font-bold mb-2">
        <span>Completed</span>
        <i class="fa-solid fa-circle-check text-emerald-500"></i>
      </div>
      <div class="text-2xl sm:text-3xl font-extrabold text-emerald-600 font-heading"><%= stats.completedCount %></div>
      <span class="text-[10px] text-slate-400 mt-1 block">Successfully hosted</span>
    </div>

  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Left 2 Cols: Upcoming Events & Recent Bookings -->
    <div class="lg:col-span-2 space-y-8">
      
      <!-- Upcoming Events Feed -->
      <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="font-heading font-bold text-lg text-slate-900 flex items-center gap-2">
            <i class="fa-solid fa-clock text-brand-600"></i> Upcoming Confirmed Events
          </h3>
          <a href="/organiser/my-bookings?status=Approved" class="text-xs font-bold text-brand-600 hover:underline">View All</a>
        </div>

        <% if (upcomingEvents && upcomingEvents.length > 0) { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <% upcomingEvents.forEach(evt => { %>
              <div class="p-4 rounded-2xl bg-indigo-50/50 border border-indigo-100 flex flex-col justify-between space-y-3">
                <div class="space-y-1">
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-indigo-100 text-indigo-800"><%= evt.eventType %></span>
                    <span class="text-xs font-mono font-bold text-slate-500"><%= evt.bookingReference %></span>
                  </div>
                  <h4 class="font-heading font-bold text-sm text-slate-900 line-clamp-1"><%= evt.eventTitle %></h4>
                  <p class="text-xs text-slate-600 font-medium flex items-center gap-1.5">
                    <i class="fa-solid fa-building text-slate-400 text-xs"></i> <%= evt.venue ? evt.venue.name : 'Campus Venue' %>
                  </p>
                  <p class="text-[11px] text-slate-500 flex items-center gap-1.5">
                    <i class="fa-regular fa-calendar text-slate-400"></i>
                    <%= new Date(evt.bookingDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %> (<%= evt.startTime %> - <%= evt.endTime %>)
                  </p>
                </div>
                <a href="/bookings/<%= evt._id %>" class="py-1.5 px-3 rounded-xl text-xs font-bold text-center text-indigo-700 bg-white border border-indigo-200 hover:bg-indigo-50 transition-colors">
                  View Booking Pass &rarr;
                </a>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 text-center text-xs text-slate-500">
            No upcoming approved events. Ready to schedule one? 
            <a href="/bookings/new" class="font-bold text-brand-600 hover:underline ml-1">Request a booking &rarr;</a>
          </div>
        <% } %>
      </div>

      <!-- Recent Bookings Table -->
      <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="font-heading font-bold text-lg text-slate-900 flex items-center gap-2">
            <i class="fa-solid fa-history text-brand-600"></i> Recent Booking Requests
          </h3>
          <a href="/organiser/my-bookings" class="text-xs font-bold text-brand-600 hover:underline">Full History &rarr;</a>
        </div>

        <% if (recentBookings && recentBookings.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="text-[10px] font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100">
                <tr>
                  <th class="py-2.5 px-2">Ref / Event</th>
                  <th class="py-2.5 px-2">Venue</th>
                  <th class="py-2.5 px-2">Date & Time</th>
                  <th class="py-2.5 px-2">Status</th>
                  <th class="py-2.5 px-2 text-right">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% recentBookings.forEach(b => { %>
                  <tr class="hover:bg-slate-50/60 transition-colors">
                    <td class="py-3 px-2">
                      <span class="font-mono text-[10px] font-bold text-brand-600 block"><%= b.bookingReference %></span>
                      <span class="font-bold text-slate-900 line-clamp-1"><%= b.eventTitle %></span>
                    </td>
                    <td class="py-3 px-2 font-medium text-slate-700">
                      <%= b.venue ? b.venue.name : 'N/A' %>
                    </td>
                    <td class="py-3 px-2 text-slate-600 whitespace-nowrap">
                      <%= new Date(b.bookingDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %><br>
                      <span class="text-[11px] text-slate-400 font-mono"><%= b.startTime %>-<%= b.endTime %></span>
                    </td>
                    <td class="py-3 px-2">
                      <span class="px-2 py-0.5 rounded-md text-[10px] font-bold <%= b.status === 'Approved' ? 'bg-indigo-100 text-indigo-800' : b.status === 'Pending' ? 'bg-amber-100 text-amber-800' : b.status === 'Completed' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
                        <%= b.status %>
                      </span>
                    </td>
                    <td class="py-3 px-2 text-right">
                      <a href="/bookings/<%= b._id %>" class="text-xs font-bold text-brand-600 hover:text-brand-800">
                        Details
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="p-6 rounded-2xl bg-slate-50 text-center text-xs text-slate-500">
            You haven't requested any venue bookings yet.
          </div>
        <% } %>
      </div>

    </div>

    <!-- Right Col: Recommended Venues -->
    <div class="lg:col-span-1 space-y-6">
      
      <div class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-sm space-y-4">
        <h3 class="font-heading font-bold text-base text-slate-900 flex items-center gap-2">
          <i class="fa-solid fa-star text-amber-400"></i> Recommended Venues
        </h3>
        <p class="text-xs text-slate-500">
          Popular campus halls equipped for high-impact seminars and student society gatherings.
        </p>

        <div class="space-y-4">
          <% (recommendedVenues || []).forEach(v => { %>
            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100 flex items-center gap-3 group hover:bg-slate-100/80 transition-colors">
              <div class="w-14 h-14 rounded-xl overflow-hidden bg-slate-200 shrink-0">
                <img src="<%= v.featuredImage || (v.images && v.images[0]) %>" alt="<%= v.name %>" class="w-full h-full object-cover">
              </div>
              <div class="flex-1 min-w-0">
                <h4 class="font-heading font-bold text-xs text-slate-900 truncate"><%= v.name %></h4>
                <p class="text-[11px] text-slate-500"><%= v.capacity %> Seats • $<%= v.hourlyRate %>/hr</p>
                <a href="/bookings/new?venueId=<%= v._id %>" class="text-[10px] font-bold text-brand-600 hover:underline mt-0.5 inline-block">
                  Book Slot &rarr;
                </a>
              </div>
            </div>
          <% }) %>
        </div>

        <a href="/venues" class="block text-center py-2.5 px-4 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors">
          Browse All Venues
        </a>
      </div>

    </div>

  </div>

</div>

<%- include('../partials/footer') %>
