<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-6">
  
  <!-- Header Title -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="font-heading font-extrabold text-2xl sm:text-3xl text-slate-900 tracking-tight">
        My Bookings & Reservations
      </h1>
      <p class="text-xs text-slate-500">
        Track your event reservations, submit payment proof, monitor administrative approvals, or download campus event passes.
      </p>
    </div>

    <a href="/bookings/new" class="py-2.5 px-4 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-brand-600 hover:bg-brand-700 shadow-md shadow-brand-500/20 transition-all hover:scale-105 flex items-center gap-1.5 self-start sm:self-auto">
      <i class="fa-solid fa-plus text-xs"></i> New Booking
    </a>
  </div>

  <!-- Status Tabs -->
  <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-slate-200">
    <a href="/organiser/my-bookings" class="px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-colors <%= currentStatus === 'All' ? 'bg-slate-900 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100' %>">
      All Bookings (<%= statusCounts.all %>)
    </a>
    <a href="/organiser/my-bookings?status=Pending" class="px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-colors <%= currentStatus === 'Pending' ? 'bg-amber-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100' %>">
      Pending (<%= statusCounts.pending %>)
    </a>
    <a href="/organiser/my-bookings?status=Approved" class="px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-colors <%= currentStatus === 'Approved' ? 'bg-indigo-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100' %>">
      Approved (<%= statusCounts.approved %>)
    </a>
    <a href="/organiser/my-bookings?status=Completed" class="px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-colors <%= currentStatus === 'Completed' ? 'bg-emerald-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100' %>">
      Completed (<%= statusCounts.completed %>)
    </a>
    <a href="/organiser/my-bookings?status=Rejected" class="px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-colors <%= currentStatus === 'Rejected' ? 'bg-rose-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100' %>">
      Rejected (<%= statusCounts.rejected %>)
    </a>
    <a href="/organiser/my-bookings?status=Cancelled" class="px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-colors <%= currentStatus === 'Cancelled' ? 'bg-slate-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100' %>">
      Cancelled (<%= statusCounts.cancelled %>)
    </a>
  </div>

  <!-- Bookings List Table -->
  <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden">
    <% if (bookings && bookings.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="text-[10px] font-bold uppercase tracking-wider text-slate-400 bg-slate-50 border-b border-slate-200">
            <tr>
              <th class="py-3.5 px-4">Reference / Event</th>
              <th class="py-3.5 px-4">Venue & Location</th>
              <th class="py-3.5 px-4">Date & Slot</th>
              <th class="py-3.5 px-4">Amount</th>
              <th class="py-3.5 px-4">Payment Status</th>
              <th class="py-3.5 px-4">Booking Status</th>
              <th class="py-3.5 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% bookings.forEach(b => { %>
              <tr class="hover:bg-slate-50/70 transition-colors">
                
                <!-- Event -->
                <td class="py-4 px-4">
                  <span class="font-mono text-[10px] font-extrabold text-brand-600 block"><%= b.bookingReference %></span>
                  <span class="font-bold text-slate-900 text-sm block"><%= b.eventTitle %></span>
                  <span class="text-[10px] text-slate-400"><%= b.eventType %> &bull; <%= b.expectedAttendees %> Pax</span>
                </td>

                <!-- Venue -->
                <td class="py-4 px-4">
                  <span class="font-bold text-slate-800 block"><%= b.venue ? b.venue.name : 'N/A' %></span>
                  <span class="text-[11px] text-slate-500"><%= b.venue ? b.venue.location : '' %></span>
                </td>

                <!-- Date & Slot -->
                <td class="py-4 px-4 whitespace-nowrap">
                  <span class="font-semibold text-slate-800 block">
                    <i class="fa-regular fa-calendar text-[10px] text-slate-400 mr-1"></i>
                    <%= new Date(b.bookingDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                  </span>
                  <span class="font-mono text-[11px] text-slate-500"><%= b.startTime %> - <%= b.endTime %> (<%= b.durationHours %> hrs)</span>
                </td>

                <!-- Amount -->
                <td class="py-4 px-4 font-extrabold text-emerald-600 text-sm whitespace-nowrap">
                  $<%= b.totalCost %>
                </td>

                <!-- Payment Status -->
                <td class="py-4 px-4">
                  <% if (b.paymentStatus === 'paid') { %>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 flex items-center gap-1 w-max">
                      <i class="fa-solid fa-circle-check text-emerald-600 text-[10px]"></i> Paid & Verified
                    </span>
                  <% } else if (b.paymentStatus === 'pending_verification') { %>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 flex items-center gap-1 w-max">
                      <i class="fa-solid fa-clock text-amber-600 text-[10px]"></i> Pending Verification
                    </span>
                    <% if (b.utrNumber) { %>
                      <span class="text-[10px] font-mono text-slate-500 block mt-1">UTR: <%= b.utrNumber %></span>
                    <% } %>
                  <% } else if (b.paymentStatus === 'rejected') { %>
                    <div class="space-y-1">
                      <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 flex items-center gap-1 w-max">
                        <i class="fa-solid fa-circle-xmark text-rose-600 text-[10px]"></i> Payment Rejected
                      </span>
                      <% if (b.rejectionReason) { %>
                        <p class="text-[10px] text-rose-600 font-medium max-w-xs leading-tight"><%= b.rejectionReason %></p>
                      <% } %>
                    </div>
                  <% } else { %>
                    <div class="space-y-1">
                      <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-slate-100 text-slate-700 flex items-center gap-1 w-max">
                        <i class="fa-solid fa-hourglass-start text-slate-500 text-[10px]"></i> Unpaid Slot Hold
                      </span>
                      <% if (b.paymentExpiresAt && new Date(b.paymentExpiresAt) > new Date()) { %>
                        <span class="text-[10px] text-amber-600 font-semibold block">15-min hold active</span>
                      <% } else { %>
                        <span class="text-[10px] text-slate-400 block">Hold expired</span>
                      <% } %>
                    </div>
                  <% } %>
                </td>

                <!-- Booking Status -->
                <td class="py-4 px-4">
                  <% if (b.status === 'Approved') { %>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-indigo-100 text-indigo-800 flex items-center gap-1 w-max">
                      <span class="w-1.5 h-1.5 rounded-full bg-indigo-600"></span> Approved
                    </span>
                  <% } else if (b.status === 'Pending') { %>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 flex items-center gap-1 w-max">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Pending Review
                    </span>
                  <% } else if (b.status === 'Completed') { %>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 flex items-center gap-1 w-max">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> Completed
                    </span>
                  <% } else if (b.status === 'Rejected') { %>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 flex items-center gap-1 w-max">
                      <span class="w-1.5 h-1.5 rounded-full bg-rose-600"></span> Rejected
                    </span>
                  <% } else { %>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-slate-100 text-slate-700 flex items-center gap-1 w-max">
                      <%= b.status %>
                    </span>
                  <% } %>
                </td>

                <!-- Actions -->
                <td class="py-4 px-4 text-right whitespace-nowrap space-y-1">
                  <% if (b.paymentStatus === 'unpaid') { %>
                    <a href="/bookings/<%= b._id %>/payment" class="inline-flex items-center gap-1 py-1 px-3 rounded-lg text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition-colors">
                      <i class="fa-solid fa-credit-card text-[10px]"></i> Pay Now &rarr;
                    </a>
                  <% } else if (b.paymentStatus === 'rejected') { %>
                    <a href="/bookings/<%= b._id %>/retry-payment" class="inline-flex items-center gap-1 py-1 px-3 rounded-lg text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 shadow-sm transition-colors">
                      <i class="fa-solid fa-rotate-right text-[10px]"></i> Retry Payment
                    </a>
                  <% } else { %>
                    <a href="/bookings/<%= b._id %>" class="inline-flex items-center gap-1 py-1 px-3 rounded-lg text-xs font-bold text-brand-700 bg-brand-50 hover:bg-brand-100 transition-colors">
                      Pass & Details &rarr;
                    </a>
                  <% } %>
                </td>

              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="p-12 text-center space-y-4">
        <div class="w-14 h-14 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center text-2xl mx-auto">
          <i class="fa-regular fa-calendar-xmark"></i>
        </div>
        <h3 class="font-heading font-extrabold text-lg text-slate-900">No Bookings Found</h3>
        <p class="text-xs text-slate-500 max-w-sm mx-auto">
          There are no bookings matching the selected status "<%= currentStatus %>".
        </p>
        <a href="/bookings/new" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-white bg-brand-600 hover:bg-brand-700 transition-colors">
          Request a Booking Now
        </a>
      </div>
    <% } %>
  </div>

</div>

<%- include('../partials/footer') %>
