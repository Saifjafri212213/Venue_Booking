<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="flex-grow py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="font-heading font-extrabold text-2xl sm:text-3xl text-slate-900">
          Network User Management
        </h1>
        <p class="text-sm text-slate-500 mt-1">
          Review, verify, and monitor registered Donors (Restaurants/Hostels) and NGO Volunteers.
        </p>
      </div>

      <!-- Role Filters -->
      <div class="flex items-center gap-2 bg-white p-1.5 rounded-2xl border border-slate-200 shadow-sm">
        <a href="/admin/users?role=all" class="px-3 py-1.5 rounded-xl text-xs font-bold <%= currentRole === 'all' ? 'bg-purple-600 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
          All Users
        </a>
        <a href="/admin/users?role=donor" class="px-3 py-1.5 rounded-xl text-xs font-bold <%= currentRole === 'donor' ? 'bg-emerald-600 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
          Donors
        </a>
        <a href="/admin/users?role=ngo" class="px-3 py-1.5 rounded-xl text-xs font-bold <%= currentRole === 'ngo' ? 'bg-amber-600 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
          NGOs / Volunteers
        </a>
      </div>
    </div>

    <!-- Users Table -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
      <% if (users && users.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                <th class="py-3.5 px-6">Entity / User</th>
                <th class="py-3.5 px-6">Role</th>
                <th class="py-3.5 px-6">Organization Type</th>
                <th class="py-3.5 px-6">Location</th>
                <th class="py-3.5 px-6">Contact Phone</th>
                <th class="py-3.5 px-6">Activity Volume</th>
                <th class="py-3.5 px-6">Verification</th>
                <th class="py-3.5 px-6 text-right">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-sm">
              <% users.forEach(u => { %>
                <tr class="hover:bg-slate-50/60 transition-colors">
                  <td class="py-4 px-6">
                    <div class="font-bold text-slate-900"><%= u.organizationName || u.name %></div>
                    <div class="text-xs text-slate-500">Contact: <%= u.name %> (<%= u.email %>)</div>
                  </td>

                  <td class="py-4 px-6">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold uppercase <%= u.role === 'ngo' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800' %>">
                      <%= u.role === 'ngo' ? 'NGO' : 'Donor' %>
                    </span>
                  </td>

                  <td class="py-4 px-6 text-xs text-slate-700 font-medium">
                    <%= u.organizationType || 'Standard' %>
                  </td>

                  <td class="py-4 px-6 text-xs text-slate-600">
                    <%= u.area || '-' %>, <%= u.pincode || '-' %>
                  </td>

                  <td class="py-4 px-6 text-xs text-slate-700">
                    <a href="tel:<%= u.phone %>" class="hover:text-emerald-600 hover:underline">
                      <i class="fa-solid fa-phone text-slate-400 mr-1"></i> <%= u.phone %>
                    </a>
                  </td>

                  <td class="py-4 px-6 font-bold text-slate-800 text-xs">
                    <%= u.activityCount %> <%= u.role === 'donor' ? 'posts' : 'claims' %>
                  </td>

                  <td class="py-4 px-6">
                    <% if (u.isVerified) { %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <i class="fa-solid fa-circle-check text-emerald-500 text-[10px]"></i> Verified
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600">
                        Unverified
                      </span>
                    <% } %>
                  </td>

                  <td class="py-4 px-6 text-right">
                    <form action="/admin/users/<%= u._id %>/toggle-status" method="POST">
                      <button
                        type="submit"
                        class="text-xs font-bold <%= u.isVerified ? 'text-amber-600 hover:text-amber-700' : 'text-emerald-600 hover:text-emerald-700' %> hover:underline"
                      >
                        <%= u.isVerified ? 'Unverify' : 'Verify' %>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="p-12 text-center text-slate-500 text-xs">
          No users registered in this role.
        </div>
      <% } %>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
