<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
  
  <!-- Header -->
  <div class="space-y-1">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-100 text-indigo-800 text-xs font-bold mb-1">
      <i class="fa-solid fa-chart-pie"></i> Utilization & Financial Reports
    </div>
    <h1 class="font-heading font-extrabold text-2xl sm:text-3xl text-slate-900 tracking-tight">
      Campus Venue Utilization & Revenue Analytics
    </h1>
    <p class="text-xs text-slate-500">
      Deep-dive analysis of booking frequency, venue load distribution, event categories, and financial performance.
    </p>
  </div>

  <!-- Top Metrics -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
    <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-1">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Confirmed Revenue</span>
      <div class="text-3xl font-extrabold text-emerald-600 font-heading">$<%= totalRevenue %></div>
      <p class="text-xs text-slate-500">Earned across approved and completed events</p>
    </div>

    <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-1">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Hours Booked</span>
      <div class="text-3xl font-extrabold text-indigo-600 font-heading"><%= totalHoursBooked %> Hours</div>
      <p class="text-xs text-slate-500">Combined campus facility usage duration</p>
    </div>

    <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-1">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Hosted Events</span>
      <div class="text-3xl font-extrabold text-slate-900 font-heading"><%= totalEvents %> Events</div>
      <p class="text-xs text-slate-500">Academic, cultural, and student society sessions</p>
    </div>
  </div>

  <!-- Charts Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Utilization Chart -->
    <div class="lg:col-span-2 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="font-heading font-bold text-base text-slate-900">Venue Utilization Load (%)</h3>
          <p class="text-xs text-slate-400">Percentage of available operating time booked</p>
        </div>
        <i class="fa-solid fa-chart-column text-indigo-600"></i>
      </div>
      <div class="h-64 relative">
        <canvas id="analyticsUtilChart"></canvas>
      </div>
    </div>

    <!-- Event Category Doughnut -->
    <div class="lg:col-span-1 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="font-heading font-bold text-base text-slate-900">Event Categories</h3>
          <p class="text-xs text-slate-400">Breakdown by activity type</p>
        </div>
        <i class="fa-solid fa-chart-pie text-brand-600"></i>
      </div>
      <div class="h-64 relative">
        <canvas id="analyticsCategoryChart"></canvas>
      </div>
    </div>

  </div>

  <!-- Detailed Table -->
  <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden p-6 sm:p-8 space-y-4">
    <h3 class="font-heading font-bold text-lg text-slate-900">Venue Performance Metrics</h3>
    
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="text-[10px] font-bold uppercase tracking-wider text-slate-400 bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="py-3 px-4">Venue Code / Name</th>
            <th class="py-3 px-4">Category</th>
            <th class="py-3 px-4">Capacity</th>
            <th class="py-3 px-4">Rate</th>
            <th class="py-3 px-4">Bookings Count</th>
            <th class="py-3 px-4">Booked Hours</th>
            <th class="py-3 px-4">Revenue Generated</th>
            <th class="py-3 px-4">Utilization</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% venueStats.forEach(item => { %>
            <tr class="hover:bg-slate-50/70 transition-colors">
              <td class="py-3 px-4">
                <span class="font-mono text-[10px] font-extrabold text-indigo-600 block"><%= item.venue.code %></span>
                <span class="font-bold text-slate-900"><%= item.venue.name %></span>
              </td>
              <td class="py-3 px-4 text-slate-600"><%= item.venue.category %></td>
              <td class="py-3 px-4 font-semibold text-slate-800"><%= item.venue.capacity %> Seats</td>
              <td class="py-3 px-4 text-slate-600">$<%= item.venue.hourlyRate %>/hr</td>
              <td class="py-3 px-4 font-bold text-slate-800"><%= item.totalBookings %></td>
              <td class="py-3 px-4 text-slate-600"><%= item.totalHours %> hrs</td>
              <td class="py-3 px-4 font-extrabold text-emerald-600">$<%= item.revenue %></td>
              <td class="py-3 px-4">
                <span class="font-bold text-slate-800"><%= item.utilizationRate %>%</span>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Chart.js Scripts -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const venueNames = <%- chartData.venueNames %>;
    const venueUtil = <%- chartData.venueUtil %>;
    const catLabels = <%- chartData.catLabels %>;
    const catCounts = <%- chartData.catCounts %>;

    // Util Chart
    const ctxUtil = document.getElementById('analyticsUtilChart');
    if (ctxUtil) {
      new Chart(ctxUtil, {
        type: 'bar',
        data: {
          labels: venueNames,
          datasets: [{
            label: 'Utilization %',
            data: venueUtil,
            backgroundColor: 'rgba(99, 102, 241, 0.85)',
            borderColor: 'rgb(79, 70, 229)',
            borderWidth: 1,
            borderRadius: 8
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: { beginAtZero: true, max: 100, ticks: { callback: (v) => v + '%' } }
          }
        }
      });
    }

    // Category Doughnut Chart
    const ctxCat = document.getElementById('analyticsCategoryChart');
    if (ctxCat) {
      new Chart(ctxCat, {
        type: 'doughnut',
        data: {
          labels: catLabels.length > 0 ? catLabels : ['Academic', 'Cultural', 'Tech Fest'],
          datasets: [{
            data: catCounts.length > 0 ? catCounts : [5, 3, 2],
            backgroundColor: [
              'rgba(99, 102, 241, 0.85)',
              'rgba(139, 92, 246, 0.85)',
              'rgba(16, 185, 129, 0.85)',
              'rgba(245, 158, 11, 0.85)',
              'rgba(239, 68, 68, 0.85)'
            ],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom' } }
        }
      });
    }
  });
</script>

<%- include('../partials/footer') %>
