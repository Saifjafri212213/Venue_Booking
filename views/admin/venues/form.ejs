<%- include('../../partials/header') %>
<%- include('../../partials/navbar') %>
<%- include('../../partials/alerts') %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-6">
  
  <!-- Header -->
  <div class="space-y-1">
    <a href="/admin/venues" class="text-xs font-bold text-indigo-600 hover:underline inline-flex items-center gap-1 mb-2">
      &larr; Back to Venues Inventory
    </a>
    <h1 class="font-heading font-extrabold text-2xl sm:text-3xl text-slate-900 tracking-tight">
      <%= isEdit ? `Edit Venue: ${venue.name}` : 'Add New Campus Venue' %>
    </h1>
    <p class="text-xs text-slate-500">
      Configure seating capacity, multimedia amenities, hourly booking rates, and operating policies.
    </p>
  </div>

  <!-- Venue Form Container -->
  <div class="bg-white p-6 sm:p-10 rounded-3xl border border-slate-200/80 shadow-sm">
    <form action="<%= isEdit ? `/admin/venues/${venue._id}` : '/admin/venues' %>" method="POST" class="space-y-6">
      
      <!-- Basic Details -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="sm:col-span-2">
          <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Venue Name *
          </label>
          <input 
            type="text" 
            name="name" 
            id="name" 
            required
            value="<%= venue ? venue.name : '' %>"
            placeholder="e.g. Grand Auditorium Hall"
            class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 font-semibold"
          >
        </div>

        <div>
          <label for="code" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Venue Code *
          </label>
          <input 
            type="text" 
            name="code" 
            id="code" 
            required
            value="<%= venue ? venue.code : '' %>"
            placeholder="AUD-01"
            class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 font-mono uppercase font-bold"
          >
        </div>
      </div>

      <!-- Category, Capacity, Hourly Rate -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label for="category" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Category *
          </label>
          <select 
            name="category" 
            id="category" 
            required
            class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 bg-white"
          >
            <% const categories = ['Auditorium', 'Conference Hall', 'Seminar Room', 'Amphitheatre', 'Workshop Lab', 'Banquet Hall', 'Sports Arena', 'Meeting Room']; %>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= venue && venue.category === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label for="capacity" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Seating Capacity *
          </label>
          <input 
            type="number" 
            name="capacity" 
            id="capacity" 
            required
            min="1"
            value="<%= venue ? venue.capacity : '' %>"
            placeholder="250"
            class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 font-semibold"
          >
        </div>

        <div>
          <label for="hourlyRate" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Hourly Rate ($) *
          </label>
          <input 
            type="number" 
            name="hourlyRate" 
            id="hourlyRate" 
            required
            min="0"
            value="<%= venue ? venue.hourlyRate : 50 %>"
            placeholder="75"
            class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 font-semibold text-emerald-600"
          >
        </div>
      </div>

      <!-- Location, Building, Floor -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label for="location" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Campus Location *
          </label>
          <input 
            type="text" 
            name="location" 
            id="location" 
            required
            value="<%= venue ? venue.location : '' %>"
            placeholder="North Campus Complex"
            class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500"
          >
        </div>

        <div>
          <label for="building" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Building / Wing
          </label>
          <input 
            type="text" 
            name="building" 
            id="building" 
            value="<%= venue ? venue.building : '' %>"
            placeholder="Science & Tech Block"
            class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500"
          >
        </div>

        <div>
          <label for="floor" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Floor Level
          </label>
          <input 
            type="text" 
            name="floor" 
            id="floor" 
            value="<%= venue ? venue.floor : '' %>"
            placeholder="2nd Floor"
            class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500"
          >
        </div>
      </div>

      <!-- Operating Hours & Status -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label for="openTime" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Open Time
          </label>
          <input 
            type="time" 
            name="openTime" 
            id="openTime" 
            value="<%= venue && venue.operatingHours ? venue.operatingHours.openTime : '08:00' %>"
            class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 font-semibold"
          >
        </div>

        <div>
          <label for="closeTime" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Close Time
          </label>
          <input 
            type="time" 
            name="closeTime" 
            id="closeTime" 
            value="<%= venue && venue.operatingHours ? venue.operatingHours.closeTime : '22:00' %>"
            class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 font-semibold"
          >
        </div>

        <div>
          <label for="status" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Status
          </label>
          <select 
            name="status" 
            id="status" 
            class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 bg-white font-bold"
          >
            <option value="active" <%= venue && venue.status === 'active' ? 'selected' : '' %>>Active (Bookable)</option>
            <option value="maintenance" <%= venue && venue.status === 'maintenance' ? 'selected' : '' %>>Under Maintenance</option>
            <option value="inactive" <%= venue && venue.status === 'inactive' ? 'selected' : '' %>>Inactive / Archived</option>
          </select>
        </div>
      </div>

      <!-- Facilities Multi-select -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
          Equipped Facilities & Amenities
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <% const standardFacilities = [
            'Projector & Screen',
            'Surround Sound Audio',
            'Stage Lighting',
            'Central AC',
            'High-Speed Wi-Fi',
            'Video Conferencing',
            'Podiums & Microphones',
            'Catering Pantry',
            'Wheelchair Accessible',
            'VIP Green Room',
            'Parking Access'
          ]; %>

          <% standardFacilities.forEach(facility => { %>
            <label class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-50 border border-slate-200/80 cursor-pointer hover:bg-slate-100 transition-colors text-xs font-semibold text-slate-700">
              <input 
                type="checkbox" 
                name="facilities" 
                value="<%= facility %>"
                <%= venue && venue.facilities && venue.facilities.includes(facility) ? 'checked' : '' %>
                class="rounded text-indigo-600 focus:ring-indigo-500 h-4 w-4 border-slate-300"
              >
              <span><%= facility %></span>
            </label>
          <% }) %>
        </div>
      </div>

      <!-- Featured Image URL -->
      <div>
        <label for="featuredImage" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Featured Image URL
        </label>
        <input 
          type="url" 
          name="featuredImage" 
          id="featuredImage" 
          value="<%= venue ? venue.featuredImage : 'https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=1200&q=80' %>"
          placeholder="https://images.unsplash.com/..."
          class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500"
        >
      </div>

      <!-- Description & Rules -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="description" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Venue Description
          </label>
          <textarea 
            name="description" 
            id="description" 
            rows="3"
            class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500"
          ><%= venue ? venue.description : '' %></textarea>
        </div>

        <div>
          <label for="rules" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            House Rules (One rule per line)
          </label>
          <textarea 
            name="rules" 
            id="rules" 
            rows="3"
            placeholder="No open flames.&#10;Vacate hall on time.&#10;Clean up after catering."
            class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500"
          ><%= venue && venue.rules ? venue.rules.join('\n') : '' %></textarea>
        </div>
      </div>

      <!-- Featured Toggle -->
      <div class="flex items-center gap-2">
        <input 
          type="checkbox" 
          name="featured" 
          id="featured"
          <%= venue && venue.featured ? 'checked' : '' %>
          class="rounded text-indigo-600 focus:ring-indigo-500 h-4 w-4 border-slate-300"
        >
        <label for="featured" class="text-xs font-bold text-slate-700 cursor-pointer">
          Feature this venue prominently on the landing page showcase
        </label>
      </div>

      <!-- Submit Buttons -->
      <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
        <a href="/admin/venues" class="py-2.5 px-5 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors">
          Cancel
        </a>
        <button 
          type="submit" 
          class="py-2.5 px-6 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-indigo-600 hover:bg-indigo-700 shadow-md shadow-indigo-500/25 transition-all hover:scale-105"
        >
          <%= isEdit ? 'Update Venue Changes' : 'Save & Publish Venue' %>
        </button>
      </div>

    </form>
  </div>

</div>

<%- include('../../partials/footer') %>
