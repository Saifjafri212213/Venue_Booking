<%- include('../../partials/header') %>
<%- include('../../partials/navbar') %>
<%- include('../../partials/alerts') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-6">
  
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-100 text-indigo-800 text-xs font-bold mb-1">
        <i class="fa-solid fa-clipboard-check"></i> Approvals & Payment Verification Inbox
      </div>
      <h1 class="font-heading font-extrabold text-2xl sm:text-3xl text-slate-900 tracking-tight">
        Booking Requests & Payment Verification
      </h1>
      <p class="text-xs text-slate-500">
        Review organiser reservations, verify transaction UTR numbers and payment screenshots, approve slots, or reject with clear reasons.
      </p>
    </div>

    <!-- Quick Action / Filter Form -->
    <div class="flex items-center gap-3 self-start sm:self-auto">
      <a href="/admin/payment-settings" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 shadow-sm transition-colors">
        <i class="fa-solid fa-gear text-indigo-600"></i> Payment Settings
      </a>

      <form action="/admin/bookings" method="GET" class="flex items-center gap-2">
        <input type="hidden" name="status" value="<%= currentFilter.status %>">
        <input type="hidden" name="paymentStatus" value="<%= currentFilter.paymentStatus %>">
        <select 
          name="venueId" 
          onchange="this.form.submit()"
          class="px-3 py-2 text-xs font-semibold rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 bg-white shadow-sm"
        >
          <option value="All">All Campus Venues</option>
          <% venues.forEach(v => { %>
            <option value="<%= v._id %>" <%= currentFilter.venueId === v._id.toString() ? 'selected' : '' %>>
              <%= v.name %> (<%= v.code %>)
            </option>
          <% }) %>
        </select>
      </form>
    </div>
  </div>

  <!-- Status Tabs -->
  <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-slate-200">
    <a href="/admin/bookings?venueId=<%= currentFilter.venueId %>" class="px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-colors <%= currentFilter.status === 'All' && currentFilter.paymentStatus === 'All' ? 'bg-slate-900 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100' %>">
      All Requests (<%= statusCounts.all %>)
    </a>
    <a href="/admin/bookings?paymentStatus=pending_verification&venueId=<%= currentFilter.venueId %>" class="px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-colors flex items-center gap-1.5 <%= currentFilter.paymentStatus === 'pending_verification' ? 'bg-amber-600 text-white shadow-sm' : 'bg-amber-50 text-amber-800 hover:bg-amber-100' %>">
      <i class="fa-solid fa-receipt text-xs"></i> Needs Verification (<%= statusCounts.pendingVerification %>)
    </a>
    <a href="/admin/bookings?status=Approved&venueId=<%= currentFilter.venueId %>" class="px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-colors <%= currentFilter.status === 'Approved' ? 'bg-indigo-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100' %>">
      Approved & Paid (<%= statusCounts.approved %>)
    </a>
    <a href="/admin/bookings?status=Pending&venueId=<%= currentFilter.venueId %>" class="px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-colors <%= currentFilter.status === 'Pending' && currentFilter.paymentStatus !== 'pending_verification' ? 'bg-slate-700 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100' %>">
      Pending (<%= statusCounts.pending %>)
    </a>
    <a href="/admin/bookings?status=Completed&venueId=<%= currentFilter.venueId %>" class="px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-colors <%= currentFilter.status === 'Completed' ? 'bg-emerald-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100' %>">
      Completed (<%= statusCounts.completed %>)
    </a>
    <a href="/admin/bookings?status=Rejected&venueId=<%= currentFilter.venueId %>" class="px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-colors <%= currentFilter.status === 'Rejected' ? 'bg-rose-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100' %>">
      Rejected (<%= statusCounts.rejected %>)
    </a>
    <a href="/admin/bookings?status=Cancelled&venueId=<%= currentFilter.venueId %>" class="px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-colors <%= currentFilter.status === 'Cancelled' ? 'bg-slate-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100' %>">
      Cancelled (<%= statusCounts.cancelled %>)
    </a>
  </div>

  <!-- Bookings Management Table -->
  <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden">
    <% if (bookings && bookings.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="text-[10px] font-bold uppercase tracking-wider text-slate-400 bg-slate-50 border-b border-slate-200">
            <tr>
              <th class="py-3.5 px-4">Ref / Event</th>
              <th class="py-3.5 px-4">Organiser</th>
              <th class="py-3.5 px-4">Venue & Slot</th>
              <th class="py-3.5 px-4">Amount</th>
              <th class="py-3.5 px-4">Payment & Proof (UTR)</th>
              <th class="py-3.5 px-4">Booking Status</th>
              <th class="py-3.5 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% bookings.forEach(b => { %>
              <tr class="hover:bg-slate-50/70 transition-colors">
                
                <!-- Ref / Event -->
                <td class="py-4 px-4">
                  <span class="font-mono text-[10px] font-extrabold text-indigo-600 block"><%= b.bookingReference %></span>
                  <span class="font-bold text-slate-900 text-sm block"><%= b.eventTitle %></span>
                  <span class="text-[10px] text-slate-400"><%= b.eventType %> &bull; <%= b.expectedAttendees %> Pax</span>
                </td>

                <!-- Organiser -->
                <td class="py-4 px-4">
                  <span class="font-bold text-slate-800 block"><%= b.organiser ? b.organiser.name : 'Unknown' %></span>
                  <span class="text-[11px] text-slate-500 block"><%= b.organiser ? b.organiser.organization : '' %></span>
                  <span class="text-[10px] text-slate-400"><%= b.organiser ? b.organiser.email : '' %></span>
                </td>

                <!-- Venue & Slot -->
                <td class="py-4 px-4 whitespace-nowrap">
                  <span class="font-bold text-slate-800 block"><%= b.venue ? b.venue.name : 'N/A' %></span>
                  <span class="font-semibold text-slate-600 block text-[11px]">
                    <i class="fa-regular fa-calendar text-[10px] text-slate-400 mr-1"></i>
                    <%= new Date(b.bookingDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                  </span>
                  <span class="font-mono text-[10px] text-slate-500"><%= b.startTime %> - <%= b.endTime %> (<%= b.durationHours %> hrs)</span>
                </td>

                <!-- Amount -->
                <td class="py-4 px-4 font-extrabold text-emerald-600 text-sm whitespace-nowrap">
                  $<%= b.totalCost %>
                </td>

                <!-- Payment & Proof (UTR + Screenshot) -->
                <td class="py-4 px-4">
                  <div class="space-y-1.5">
                    <!-- Payment Status Pill -->
                    <div>
                      <% if (b.paymentStatus === 'paid') { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-100 text-emerald-800">
                          <i class="fa-solid fa-circle-check text-[10px]"></i> Paid & Verified
                        </span>
                      <% } else if (b.paymentStatus === 'pending_verification') { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-100 text-amber-800 animate-pulse">
                          <i class="fa-solid fa-clock text-[10px]"></i> Verification Required
                        </span>
                      <% } else if (b.paymentStatus === 'rejected') { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-rose-100 text-rose-800">
                          <i class="fa-solid fa-circle-xmark text-[10px]"></i> Payment Rejected
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-slate-100 text-slate-600">
                          <i class="fa-solid fa-hourglass-start text-[10px]"></i> Unpaid Hold
                        </span>
                      <% } %>
                    </div>

                    <!-- UTR Reference -->
                    <% if (b.utrNumber) { %>
                      <div class="flex items-center gap-1 font-mono text-[11px] font-bold text-slate-800">
                        <span class="text-slate-400 text-[10px]">UTR:</span>
                        <span><%= b.utrNumber %></span>
                      </div>
                    <% } %>

                    <!-- Screenshot Button -->
                    <% if (b.paymentScreenshot) { %>
                      <button 
                        type="button" 
                        onclick="openScreenshotModal('<%= b.paymentScreenshot %>', '<%= b.bookingReference %>', '<%= b.utrNumber || 'N/A' %>')"
                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 transition-colors"
                      >
                        <i class="fa-solid fa-image text-[9px]"></i> View Proof Screenshot
                      </button>
                    <% } %>
                  </div>
                </td>

                <!-- Booking Status -->
                <td class="py-4 px-4">
                  <% if (b.status === 'Approved') { %>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-indigo-100 text-indigo-800 flex items-center gap-1 w-max">
                      <span class="w-1.5 h-1.5 rounded-full bg-indigo-600"></span> Approved
                    </span>
                  <% } else if (b.status === 'Pending') { %>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 flex items-center gap-1 w-max">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Pending Review
                    </span>
                  <% } else if (b.status === 'Completed') { %>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 flex items-center gap-1 w-max">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> Completed
                    </span>
                  <% } else if (b.status === 'Rejected') { %>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 flex items-center gap-1 w-max">
                      <span class="w-1.5 h-1.5 rounded-full bg-rose-600"></span> Rejected
                    </span>
                  <% } else { %>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-slate-100 text-slate-700 flex items-center gap-1 w-max">
                      <%= b.status %>
                    </span>
                  <% } %>
                </td>

                <!-- Actions -->
                <td class="py-4 px-4 text-right whitespace-nowrap space-x-1.5">
                  <% if (b.status === 'Pending' || b.paymentStatus === 'pending_verification') { %>
                    <form action="/admin/bookings/<%= b._id %>/approve" method="POST" class="inline">
                      <button type="submit" title="Verify Payment & Approve Booking" class="py-1 px-2.5 rounded-lg text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 shadow-sm transition-colors">
                        <i class="fa-solid fa-check mr-1 text-[10px]"></i> Approve
                      </button>
                    </form>
                    <button type="button" onclick="openRejectModal('<%= b._id %>', '<%= b.bookingReference %>')" class="py-1 px-2.5 rounded-lg text-xs font-bold text-rose-600 bg-rose-50 hover:bg-rose-100 transition-colors">
                      <i class="fa-solid fa-xmark mr-1 text-[10px]"></i> Reject
                    </button>
                  <% } else if (b.status === 'Approved') { %>
                    <form action="/admin/bookings/<%= b._id %>/status" method="POST" class="inline">
                      <input type="hidden" name="status" value="Completed">
                      <button type="submit" class="py-1 px-2.5 rounded-lg text-xs font-bold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 transition-colors">
                        Mark Done
                      </button>
                    </form>
                  <% } %>

                  <a href="/bookings/<%= b._id %>" class="inline-block py-1 px-2 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 hover:bg-slate-100" title="View Details / Pass">
                    <i class="fa-solid fa-eye text-[11px]"></i>
                  </a>
                </td>

              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="p-12 text-center space-y-4">
        <div class="w-14 h-14 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center text-2xl mx-auto">
          <i class="fa-regular fa-folder-open"></i>
        </div>
        <h3 class="font-heading font-extrabold text-lg text-slate-900">No Booking Requests Found</h3>
        <p class="text-xs text-slate-500 max-w-sm mx-auto">
          No bookings match the selected filters. Change the status filter above to view other records.
        </p>
      </div>
    <% } %>
  </div>

</div>

<!-- Screenshot Preview Modal -->
<div id="screenshotModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/70 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl max-w-xl w-full p-6 space-y-4 shadow-2xl animate-fade-in border border-slate-200">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <div>
        <h3 class="font-heading font-extrabold text-base text-slate-900 flex items-center gap-2">
          <i class="fa-solid fa-file-invoice-dollar text-indigo-600"></i> Payment Proof Screenshot
        </h3>
        <p class="text-[11px] text-slate-500">
          Booking: <span id="screenshotModalRef" class="font-mono font-bold text-indigo-600"></span> &bull; UTR: <span id="screenshotModalUtr" class="font-mono font-bold text-slate-800"></span>
        </p>
      </div>
      <button onclick="closeScreenshotModal()" class="text-slate-400 hover:text-slate-600 p-1">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <div class="max-h-[70vh] overflow-auto rounded-2xl bg-slate-100 border border-slate-200 flex items-center justify-center p-2">
      <img id="screenshotModalImg" src="" alt="Payment Proof" class="max-w-full max-h-[60vh] object-contain rounded-xl shadow-sm">
    </div>

    <div class="flex justify-end">
      <button type="button" onclick="closeScreenshotModal()" class="py-2 px-5 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors">
        Close Preview
      </button>
    </div>
  </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl max-w-md w-full p-6 space-y-4 shadow-2xl animate-fade-in border border-slate-200">
    <div class="flex items-center justify-between">
      <h3 class="font-heading font-extrabold text-lg text-slate-900">Reject Booking / Payment</h3>
      <button onclick="closeRejectModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-lg"></i></button>
    </div>
    <p class="text-xs text-slate-600">
      Please provide a reason for rejecting booking <strong id="rejectModalRef" class="text-slate-900"></strong> (this reason will be displayed to the organiser so they can retry payment):
    </p>
    <form id="rejectForm" action="" method="POST" class="space-y-4">
      <div>
        <label for="rejectionReason" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Rejection Reason *
        </label>
        <textarea 
          name="rejectionReason" 
          id="rejectionReason" 
          required
          rows="3"
          placeholder="e.g. UTR number not found in bank statement, amount mismatch, or slot unavailable..."
          class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-rose-500/30 focus:border-rose-500"
        ></textarea>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <button type="button" onclick="closeRejectModal()" class="py-2.5 px-4 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors">
          Cancel
        </button>
        <button type="submit" class="py-2.5 px-4 rounded-xl text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 transition-colors">
          Reject Request
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openRejectModal(bookingId, reference) {
    document.getElementById('rejectForm').action = '/admin/bookings/' + bookingId + '/reject';
    document.getElementById('rejectModalRef').textContent = reference;
    document.getElementById('rejectModal').classList.remove('hidden');
  }
  function closeRejectModal() {
    document.getElementById('rejectModal').classList.add('hidden');
  }

  function openScreenshotModal(imgSrc, ref, utr) {
    document.getElementById('screenshotModalImg').src = imgSrc;
    document.getElementById('screenshotModalRef').textContent = ref;
    document.getElementById('screenshotModalUtr').textContent = utr;
    document.getElementById('screenshotModal').classList.remove('hidden');
  }
  function closeScreenshotModal() {
    document.getElementById('screenshotModal').classList.add('hidden');
  }
</script>

<%- include('../../partials/footer') %>
