<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
  
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-100 text-indigo-800 text-xs font-bold mb-2">
        <i class="fa-solid fa-credit-card"></i> Finance & Payment Gateway
      </div>
      <h1 class="font-heading font-extrabold text-2xl sm:text-3xl text-slate-900 tracking-tight">
        Bank & UPI Payment Settings
      </h1>
      <p class="text-xs text-slate-500 max-w-2xl">
        Configure the official university bank account and UPI details displayed to organisers during the "payment-first" booking checkout flow. Dynamic UPI QR codes are automatically generated based on these credentials.
      </p>
    </div>

    <a href="/admin/bookings" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 shadow-sm transition-colors self-start sm:self-auto">
      <i class="fa-solid fa-arrow-left text-xs"></i> Back to Approvals
    </a>
  </div>

  <form action="/admin/payment-settings" method="POST" enctype="multipart/form-data" class="space-y-8">
    <input type="hidden" name="existingQr" value="<%= settings.customQrImage || '' %>">

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Left Column: Bank Account Details Form -->
      <div class="lg:col-span-2 space-y-6">
        
        <!-- Primary Bank Account Card -->
        <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6 sm:p-8 space-y-6">
          <div class="flex items-center justify-between border-b border-slate-100 pb-4">
            <h2 class="font-heading font-extrabold text-lg text-slate-900 flex items-center gap-2">
              <i class="fa-solid fa-building-columns text-indigo-600"></i> Institutional Bank Account Details
            </h2>
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Required *</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            
            <!-- Account Holder Name -->
            <div class="sm:col-span-2">
              <label for="accountHolderName" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Account Holder / Beneficiary Name *
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                  <i class="fa-solid fa-user-shield text-xs"></i>
                </div>
                <input 
                  type="text" 
                  name="accountHolderName" 
                  id="accountHolderName" 
                  required
                  value="<%= settings.accountHolderName || '' %>"
                  placeholder="e.g. Campus Facilities & Venue Administration"
                  class="w-full pl-9 pr-3 py-2.5 text-xs rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 font-medium text-slate-900"
                >
              </div>
              <p class="text-[10px] text-slate-400 mt-1">Beneficiary name as registered with the banking institution.</p>
            </div>

            <!-- Bank Name -->
            <div>
              <label for="bankName" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Bank Name *
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                  <i class="fa-solid fa-landmark text-xs"></i>
                </div>
                <input 
                  type="text" 
                  name="bankName" 
                  id="bankName" 
                  required
                  value="<%= settings.bankName || '' %>"
                  placeholder="e.g. State Bank of India"
                  class="w-full pl-9 pr-3 py-2.5 text-xs rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 font-medium text-slate-900"
                >
              </div>
            </div>

            <!-- Branch Name -->
            <div>
              <label for="branchName" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Branch Name / Location
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                  <i class="fa-solid fa-location-dot text-xs"></i>
                </div>
                <input 
                  type="text" 
                  name="branchName" 
                  id="branchName" 
                  value="<%= settings.branchName || '' %>"
                  placeholder="e.g. University Main Campus Branch"
                  class="w-full pl-9 pr-3 py-2.5 text-xs rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 font-medium text-slate-900"
                >
              </div>
            </div>

            <!-- Account Number -->
            <div>
              <label for="accountNumber" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Bank Account Number *
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                  <i class="fa-solid fa-money-check-dollar text-xs"></i>
                </div>
                <input 
                  type="text" 
                  name="accountNumber" 
                  id="accountNumber" 
                  required
                  value="<%= settings.accountNumber || '' %>"
                  placeholder="e.g. 40928172901"
                  class="w-full pl-9 pr-3 py-2.5 text-xs rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 font-mono font-bold text-slate-900 tracking-wider"
                >
              </div>
            </div>

            <!-- IFSC Code -->
            <div>
              <label for="ifscCode" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                IFSC Code *
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                  <i class="fa-solid fa-shield-halved text-xs"></i>
                </div>
                <input 
                  type="text" 
                  name="ifscCode" 
                  id="ifscCode" 
                  required
                  value="<%= settings.ifscCode || '' %>"
                  placeholder="e.g. SBIN0001234"
                  maxlength="11"
                  class="w-full pl-9 pr-3 py-2.5 text-xs rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 font-mono font-extrabold uppercase text-indigo-700 tracking-wider"
                >
              </div>
              <p class="text-[10px] text-slate-400 mt-1">11-character Indian Financial System Code.</p>
            </div>

          </div>
        </div>

        <!-- UPI Configuration Card -->
        <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6 sm:p-8 space-y-6">
          <div class="flex items-center justify-between border-b border-slate-100 pb-4">
            <h2 class="font-heading font-extrabold text-lg text-slate-900 flex items-center gap-2">
              <i class="fa-solid fa-qrcode text-indigo-600"></i> UPI Identifier & Dynamic QR Integration
            </h2>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-emerald-100 text-emerald-800">
              Live Auto-QR
            </span>
          </div>

          <div class="space-y-4">
            <div>
              <label for="upiId" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Official UPI ID / VPA *
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                  <i class="fa-solid fa-at text-xs"></i>
                </div>
                <input 
                  type="text" 
                  name="upiId" 
                  id="upiId" 
                  required
                  value="<%= settings.upiId || '' %>"
                  placeholder="e.g. campusfacilities@sbi"
                  class="w-full pl-9 pr-3 py-2.5 text-xs rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 font-mono font-bold text-slate-900"
                >
              </div>
              <p class="text-[10px] text-slate-400 mt-1">
                The system dynamically embeds this UPI VPA along with the exact booking amount and booking reference into scanned QR codes.
              </p>
            </div>

            <!-- Optional Static Custom QR Override -->
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Custom Static QR Code Image (Optional Fallback)
              </label>
              <div class="flex items-center gap-4">
                <div class="flex-1">
                  <input 
                    type="file" 
                    name="qrImage" 
                    id="qrImage"
                    accept="image/png,image/jpeg,image/webp,image/jpg"
                    class="block w-full text-xs text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 transition-colors"
                  >
                  <p class="text-[10px] text-slate-400 mt-1">Upload a standalone high-res QR image if you prefer a static merchant QR code (PNG, JPG, max 5MB).</p>
                </div>
                <% if (settings.customQrImage) { %>
                  <div class="w-16 h-16 rounded-xl border border-slate-200 overflow-hidden shrink-0 bg-slate-50 p-1">
                    <img src="<%= settings.customQrImage %>" alt="Custom QR" class="w-full h-full object-contain">
                  </div>
                <% } %>
              </div>
            </div>

            <!-- Organiser Instructions -->
            <div>
              <label for="instructions" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Checkout Notes & Instructions for Organisers
              </label>
              <textarea 
                name="instructions" 
                id="instructions" 
                rows="3"
                class="w-full px-3 py-2.5 text-xs rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 text-slate-800"
                placeholder="e.g. Please transfer the exact fee and submit your 12-digit UTR/UPI transaction reference. Uploading a payment screenshot expedites confirmation."
              ><%= settings.instructions || '' %></textarea>
            </div>

          </div>
        </div>

      </div>

      <!-- Right Column: Settings Status & Action Box -->
      <div class="space-y-6">
        
        <!-- Activation & Status Card -->
        <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6 space-y-6">
          <h3 class="font-heading font-extrabold text-sm uppercase tracking-wider text-slate-900 border-b border-slate-100 pb-3">
            Gateway Status & Control
          </h3>

          <div class="flex items-center justify-between p-4 rounded-2xl bg-indigo-50/60 border border-indigo-100">
            <div>
              <span class="text-xs font-bold text-slate-900 block">Active Gateway</span>
              <span class="text-[10px] text-slate-500">Enable this bank account for checkout</span>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input 
                type="checkbox" 
                name="isActive" 
                value="true" 
                class="sr-only peer" 
                <%= settings.isActive ? 'checked' : '' %>
              >
              <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600"></div>
            </label>
          </div>

          <!-- Security Highlights -->
          <div class="space-y-3 text-xs text-slate-600">
            <div class="flex items-start gap-2">
              <i class="fa-solid fa-circle-check text-emerald-500 mt-0.5 text-[11px]"></i>
              <span><strong>Slot Hold Protection:</strong> Unpaid bookings hold slot for 15 mins.</span>
            </div>
            <div class="flex items-start gap-2">
              <i class="fa-solid fa-circle-check text-emerald-500 mt-0.5 text-[11px]"></i>
              <span><strong>Duplicate UTR Lock:</strong> Prevents transaction reference re-use.</span>
            </div>
            <div class="flex items-start gap-2">
              <i class="fa-solid fa-circle-check text-emerald-500 mt-0.5 text-[11px]"></i>
              <span><strong>Admin Moderation:</strong> Slots are only locked when admin approves payment.</span>
            </div>
          </div>

          <div class="pt-2">
            <button 
              type="submit" 
              class="w-full py-3 px-4 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r from-indigo-600 to-brand-600 hover:from-indigo-700 hover:to-brand-700 shadow-md shadow-indigo-500/20 transition-all hover:scale-[1.02] flex items-center justify-center gap-2"
            >
              <i class="fa-solid fa-floppy-disk text-xs"></i> Save Payment Settings
            </button>
          </div>
        </div>

        <!-- Live Organiser Preview Widget -->
        <div class="bg-gradient-to-br from-slate-900 to-indigo-950 rounded-3xl p-6 text-white space-y-4 shadow-xl">
          <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <span class="text-[10px] font-extrabold uppercase tracking-widest text-indigo-300">Live Organiser Preview</span>
            <i class="fa-solid fa-mobile-screen text-indigo-400"></i>
          </div>

          <div class="space-y-2 text-xs">
            <div class="flex justify-between text-slate-400">
              <span>UPI ID:</span>
              <span class="font-mono text-indigo-200 font-bold"><%= settings.upiId || 'Not Set' %></span>
            </div>
            <div class="flex justify-between text-slate-400">
              <span>Bank:</span>
              <span class="text-white font-semibold"><%= settings.bankName || 'Not Set' %></span>
            </div>
            <div class="flex justify-between text-slate-400">
              <span>IFSC:</span>
              <span class="font-mono text-white"><%= settings.ifscCode || 'Not Set' %></span>
            </div>
          </div>

          <div class="pt-2 border-t border-white/10 text-center">
            <span class="text-[10px] text-slate-400">Dynamic QR is auto-generated on checkout with exact booking cost.</span>
          </div>
        </div>

      </div>

    </div>
  </form>

</div>

<%- include('../partials/footer') %>
