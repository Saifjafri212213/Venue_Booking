<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="flex-grow py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="font-heading font-extrabold text-2xl sm:text-3xl text-slate-900">
          All Network Food Donations
        </h1>
        <p class="text-sm text-slate-500 mt-1">
          Monitor all food surplus postings, track NGO fulfillment, and manage cancellations.
        </p>
      </div>

      <a href="/admin/analytics" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow transition-all">
        <i class="fa-solid fa-chart-line"></i>
        <span>Visual Reports</span>
      </a>
    </div>

    <!-- Filters Box -->
    <div class="bg-white rounded-3xl p-5 border border-slate-200 shadow-sm">
      <form action="/admin/donations" method="GET" class="grid grid-cols-1 sm:grid-cols-4 gap-3">
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">Search Keywords</label>
          <input
            type="text"
            name="search"
            value="<%= filters.search %>"
            placeholder="Food title, contact, pincode..."
            class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500"
          >
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">Filter by Area</label>
          <input
            type="text"
            name="area"
            value="<%= filters.area %>"
            placeholder="e.g. Indiranagar"
            class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500"
          >
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">Status</label>
          <select name="status" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 bg-white focus:ring-2 focus:ring-emerald-500">
            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
            <option value="Available" <%= filters.status === 'Available' ? 'selected' : '' %>>Available (Unclaimed)</option>
            <option value="Claimed" <%= filters.status === 'Claimed' ? 'selected' : '' %>>Claimed</option>
            <option value="Picked Up" <%= filters.status === 'Picked Up' ? 'selected' : '' %>>Picked Up</option>
            <option value="Delivered" <%= filters.status === 'Delivered' ? 'selected' : '' %>>Delivered (Completed)</option>
            <option value="Cancelled" <%= filters.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
            <option value="Expired" <%= filters.status === 'Expired' ? 'selected' : '' %>>Expired</option>
          </select>
        </div>

        <div class="flex items-end gap-2">
          <button type="submit" class="w-full py-2 px-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs shadow transition-all">
            Filter
          </button>
          <% if (filters.search || filters.area || filters.status !== 'all') { %>
            <a href="/admin/donations" class="py-2 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs text-center transition-colors">
              Reset
            </a>
          <% } %>
        </div>
      </form>
    </div>

    <!-- Master Donations Table -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
      <% if (donations && donations.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                <th class="py-3.5 px-6">Food Post</th>
                <th class="py-3.5 px-6">Donor Details</th>
                <th class="py-3.5 px-6">Quantity</th>
                <th class="py-3.5 px-6">Area & Pincode</th>
                <th class="py-3.5 px-6">Expiry</th>
                <th class="py-3.5 px-6">Claimed NGO</th>
                <th class="py-3.5 px-6">Status</th>
                <th class="py-3.5 px-6 text-right">Admin Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-sm">
              <% donations.forEach(item => { %>
                <tr class="hover:bg-slate-50/60 transition-colors">
                  <td class="py-4 px-6">
                    <div class="font-bold text-slate-900"><%= item.foodTitle %></div>
                    <div class="text-[11px] text-slate-500"><%= item.foodType %> • <%= item.dietaryType %></div>
                  </td>

                  <td class="py-4 px-6 text-xs">
                    <div class="font-bold text-slate-800"><%= item.donor ? item.donor.organizationName || item.donor.name : 'Unknown Donor' %></div>
                    <div class="text-slate-500"><i class="fa-solid fa-phone text-[10px] text-emerald-600"></i> <%= item.contactPhone %></div>
                  </td>

                  <td class="py-4 px-6 font-bold text-slate-800 text-xs">
                    <%= item.quantity %> <%= item.quantityUnit %>
                  </td>

                  <td class="py-4 px-6 text-xs text-slate-600">
                    <div><strong><%= item.area %></strong>, <%= item.pincode %></div>
                    <div class="text-[11px] text-slate-400 truncate max-w-[180px]"><%= item.pickupAddress %></div>
                  </td>

                  <td class="py-4 px-6 text-xs text-slate-600">
                    <%= new Date(item.expiryTime).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                  </td>

                  <td class="py-4 px-6 text-xs">
                    <% if (item.claimedBy) { %>
                      <div class="font-bold text-slate-800"><%= item.claimedBy.organizationName || item.claimedBy.name %></div>
                      <div class="text-slate-500"><%= item.claimedBy.phone %></div>
                    <% } else { %>
                      <span class="text-slate-400 italic">Unclaimed</span>
                    <% } %>
                  </td>

                  <td class="py-4 px-6">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold <%= item.status === 'Available' ? 'bg-emerald-100 text-emerald-800' : (item.status === 'Claimed' ? 'bg-amber-100 text-amber-800' : (item.status === 'Picked Up' ? 'bg-blue-100 text-blue-800' : (item.status === 'Delivered' ? 'bg-teal-100 text-teal-800' : 'bg-rose-100 text-rose-800'))) %>">
                      <%= item.status %>
                    </span>
                  </td>

                  <td class="py-4 px-6 text-right">
                    <% if (item.status !== 'Delivered' && item.status !== 'Cancelled') { %>
                      <form action="/admin/donations/<%= item._id %>/cancel" method="POST" onsubmit="return confirm('Cancel this donation across the network?');">
                        <button type="submit" class="text-xs text-rose-600 hover:text-rose-800 font-bold hover:underline">
                          Cancel
                        </button>
                      </form>
                    <% } else { %>
                      <span class="text-xs text-slate-400">-</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="p-12 text-center text-slate-500 text-xs">
          No donations found matching the selected filters.
        </div>
      <% } %>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
