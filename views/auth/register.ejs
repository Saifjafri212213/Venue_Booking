<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<div class="min-h-[calc(100vh-14rem)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-xl w-full space-y-6">
    
    <!-- Header -->
    <div class="text-center space-y-2">
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-brand-600 to-accent-600 text-white flex items-center justify-center mx-auto shadow-lg shadow-brand-500/25">
        <i class="fa-solid fa-user-plus text-2xl"></i>
      </div>
      <h2 class="font-heading font-extrabold text-3xl text-slate-900 tracking-tight">
        Create Your Account
      </h2>
      <p class="text-xs text-slate-500 max-w-sm mx-auto">
        Join the campus event management ecosystem as an Event Organiser or Venue Administrator.
      </p>
    </div>

    <!-- Registration Form -->
    <div class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-sm space-y-6">
      
      <!-- Client-Side Dynamic Error Alert (Hidden by default) -->
      <div id="clientErrorAlert" class="hidden p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold flex items-center gap-2.5 transition-all">
        <div class="w-6 h-6 rounded-lg bg-rose-100 flex items-center justify-center text-rose-600 shrink-0">
          <i class="fa-solid fa-triangle-exclamation text-xs"></i>
        </div>
        <span id="clientErrorMsg">Please check the password fields.</span>
      </div>

      <form id="registerForm" action="/auth/register" method="POST" class="space-y-4" novalidate>
        
        <!-- Role Selection Cards -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
            Select Your Role
          </label>
          <div class="grid grid-cols-2 gap-3">
            <label id="card_organiser" class="relative flex flex-col p-4 rounded-2xl border-2 border-brand-500 bg-brand-50/40 cursor-pointer hover:bg-brand-50/70 transition-colors role-card" onclick="selectRole('organiser')">
              <input type="radio" name="role" value="organiser" class="sr-only" <%= (typeof formData === 'undefined' || !formData.role || formData.role === 'organiser') ? 'checked' : '' %> id="role_organiser">
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm font-bold text-brand-900">Organiser</span>
                <i class="fa-solid fa-circle-check text-brand-600 text-base" id="icon_organiser"></i>
              </div>
              <span class="text-[11px] text-slate-500 leading-tight">Student club, faculty, or community event host</span>
            </label>

            <label id="card_admin" class="relative flex flex-col p-4 rounded-2xl border-2 border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition-colors role-card" onclick="selectRole('admin')">
              <input type="radio" name="role" value="admin" class="sr-only" <%= (typeof formData !== 'undefined' && formData.role === 'admin') ? 'checked' : '' %> id="role_admin">
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm font-bold text-slate-800">Venue Admin</span>
                <i class="fa-regular fa-circle text-slate-300 text-base" id="icon_admin"></i>
              </div>
              <span class="text-[11px] text-slate-500 leading-tight">Facilities manager, approvals & maintenance</span>
            </label>
          </div>
        </div>

        <!-- Full Name & Email -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Full Name *
            </label>
            <input 
              type="text" 
              name="name" 
              id="name" 
              required
              value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>"
              placeholder="e.g. Alex Rivera"
              class="block w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition-all"
            >
          </div>

          <div>
            <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Email Address *
            </label>
            <input 
              type="email" 
              name="email" 
              id="email" 
              required
              value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
              placeholder="alex@campus.edu"
              class="block w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition-all"
            >
          </div>
        </div>

        <!-- Department & Organization -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="department" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Department / Faculty
            </label>
            <input 
              type="text" 
              name="department" 
              id="department" 
              value="<%= typeof formData !== 'undefined' && formData.department ? formData.department : '' %>"
              placeholder="Computer Science / Student Affairs"
              class="block w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition-all"
            >
          </div>

          <div>
            <label for="organization" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Club / Organization Name
            </label>
            <input 
              type="text" 
              name="organization" 
              id="organization" 
              value="<%= typeof formData !== 'undefined' && formData.organization ? formData.organization : '' %>"
              placeholder="Tech Innovators Society"
              class="block w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition-all"
            >
          </div>
        </div>

        <!-- Phone Number -->
        <div>
          <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Contact Phone
          </label>
          <input 
            type="text" 
            name="phone" 
            id="phone" 
            value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
            placeholder="+1 (555) 234-5678"
            class="block w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition-all"
          >
        </div>

        <!-- Passwords with Live Validation and Toggle Visibility -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <!-- Password Input -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="password" class="block text-xs font-bold uppercase tracking-wider text-slate-700">
                Password *
              </label>
              <span id="pwdLengthBadge" class="text-[10px] font-semibold text-slate-400">min 6 chars</span>
            </div>
            
            <div class="relative rounded-xl">
              <input 
                type="password" 
                name="password" 
                id="password" 
                required
                placeholder="••••••••"
                class="block w-full pl-3.5 pr-10 py-2.5 text-sm rounded-xl border border-slate-300 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition-all"
              >
              <button 
                type="button" 
                onclick="togglePasswordVisibility('password', 'pwdToggleIcon')" 
                class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 focus:outline-none"
                tabindex="-1"
                title="Toggle password visibility"
              >
                <i class="fa-regular fa-eye text-sm" id="pwdToggleIcon"></i>
              </button>
            </div>
            <p id="pwdHint" class="text-[11px] text-slate-500 mt-1.5 flex items-center gap-1.5">
              <i class="fa-solid fa-circle-info text-[10px]"></i> At least 6 characters
            </p>
          </div>

          <!-- Confirm Password Input -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="confirmPassword" class="block text-xs font-bold uppercase tracking-wider text-slate-700">
                Confirm Password *
              </label>
              <span id="matchStatusBadge" class="text-[10px] font-semibold text-slate-400">Match verification</span>
            </div>

            <div class="relative rounded-xl">
              <input 
                type="password" 
                name="confirmPassword" 
                id="confirmPassword" 
                required
                placeholder="••••••••"
                class="block w-full pl-3.5 pr-10 py-2.5 text-sm rounded-xl border border-slate-300 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition-all <%= (typeof passwordMismatch !== 'undefined' && passwordMismatch) ? 'border-rose-500 ring-2 ring-rose-500/20 bg-rose-50/30' : '' %>"
              >
              <button 
                type="button" 
                onclick="togglePasswordVisibility('confirmPassword', 'confirmPwdToggleIcon')" 
                class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 focus:outline-none"
                tabindex="-1"
                title="Toggle confirm password visibility"
              >
                <i class="fa-regular fa-eye text-sm" id="confirmPwdToggleIcon"></i>
              </button>
            </div>

            <!-- Dynamic UI Message for Confirm Password Match -->
            <div id="matchFeedback" class="mt-1.5">
              <% if (typeof passwordMismatch !== 'undefined' && passwordMismatch) { %>
                <p class="text-[11px] font-semibold text-rose-600 flex items-center gap-1.5 animate-shake">
                  <i class="fa-solid fa-circle-xmark text-rose-500"></i> Passwords do not match
                </p>
              <% } else { %>
                <p class="text-[11px] text-slate-500 flex items-center gap-1.5">
                  <i class="fa-solid fa-shield-halved text-[10px]"></i> Re-enter password to verify
                </p>
              <% } %>
            </div>
          </div>

        </div>

        <button 
          id="submitBtn"
          type="submit" 
          class="w-full py-3 px-4 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-brand-600 to-accent-600 hover:from-brand-700 hover:to-accent-700 shadow-md shadow-brand-500/25 transition-all hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-brand-500/50 mt-2"
        >
          Complete Registration &rarr;
        </button>

      </form>

      <div class="text-center pt-2 border-t border-slate-100">
        <p class="text-xs text-slate-500">
          Already have an account? 
          <a href="/auth/login" class="font-bold text-brand-600 hover:text-brand-700 ml-1">Sign in instead</a>
        </p>
      </div>
    </div>

  </div>
</div>

<style>
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-6px); }
    40%, 80% { transform: translateX(6px); }
  }
  .animate-shake {
    animation: shake 0.4s ease-in-out;
  }
</style>

<script>
  // Role selector function
  function selectRole(role) {
    const orgRadio = document.getElementById('role_organiser');
    const adminRadio = document.getElementById('role_admin');
    const orgCard = document.getElementById('card_organiser');
    const adminCard = document.getElementById('card_admin');
    const orgIcon = document.getElementById('icon_organiser');
    const adminIcon = document.getElementById('icon_admin');
    
    if (role === 'organiser') {
      orgRadio.checked = true;
      orgCard.className = 'relative flex flex-col p-4 rounded-2xl border-2 border-brand-500 bg-brand-50/40 cursor-pointer hover:bg-brand-50/70 transition-colors role-card';
      adminCard.className = 'relative flex flex-col p-4 rounded-2xl border-2 border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition-colors role-card';
      orgIcon.className = 'fa-solid fa-circle-check text-brand-600 text-base';
      adminIcon.className = 'fa-regular fa-circle text-slate-300 text-base';
    } else {
      adminRadio.checked = true;
      adminCard.className = 'relative flex flex-col p-4 rounded-2xl border-2 border-indigo-500 bg-indigo-50/40 cursor-pointer hover:bg-indigo-50/70 transition-colors role-card';
      orgCard.className = 'relative flex flex-col p-4 rounded-2xl border-2 border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition-colors role-card';
      adminIcon.className = 'fa-solid fa-circle-check text-indigo-600 text-base';
      orgIcon.className = 'fa-regular fa-circle text-slate-300 text-base';
    }
  }

  // Initialize selected role on load if admin was chosen
  document.addEventListener('DOMContentLoaded', () => {
    const adminRadio = document.getElementById('role_admin');
    if (adminRadio && adminRadio.checked) {
      selectRole('admin');
    }
  });

  // Toggle show/hide password helper
  function togglePasswordVisibility(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (input.type === 'password') {
      input.type = 'text';
      icon.className = 'fa-regular fa-eye-slash text-sm text-brand-600';
    } else {
      input.type = 'password';
      icon.className = 'fa-regular fa-eye text-sm text-slate-400';
    }
  }

  // Live Password & Confirm Password Validation
  const pwdInput = document.getElementById('password');
  const confirmPwdInput = document.getElementById('confirmPassword');
  const matchFeedback = document.getElementById('matchFeedback');
  const matchStatusBadge = document.getElementById('matchStatusBadge');
  const pwdHint = document.getElementById('pwdHint');
  const pwdLengthBadge = document.getElementById('pwdLengthBadge');
  const regForm = document.getElementById('registerForm');
  const clientAlert = document.getElementById('clientErrorAlert');
  const clientErrorMsg = document.getElementById('clientErrorMsg');

  function checkPasswordMatch() {
    const pVal = pwdInput.value;
    const cpVal = confirmPwdInput.value;

    // Password length validation feedback
    if (pVal.length === 0) {
      pwdInput.classList.remove('border-rose-500', 'border-emerald-500', 'ring-2', 'ring-rose-500/20', 'ring-emerald-500/20', 'bg-rose-50/30', 'bg-emerald-50/30');
      pwdHint.innerHTML = '<i class="fa-solid fa-circle-info text-[10px]"></i> At least 6 characters';
      pwdHint.className = 'text-[11px] text-slate-500 mt-1.5 flex items-center gap-1.5';
      pwdLengthBadge.textContent = 'min 6 chars';
      pwdLengthBadge.className = 'text-[10px] font-semibold text-slate-400';
    } else if (pVal.length < 6) {
      pwdInput.classList.add('border-rose-500', 'ring-2', 'ring-rose-500/20');
      pwdInput.classList.remove('border-emerald-500', 'ring-emerald-500/20');
      pwdHint.innerHTML = '<i class="fa-solid fa-circle-exclamation text-[10px] text-rose-500"></i> Password is too short (min 6 chars)';
      pwdHint.className = 'text-[11px] text-rose-600 font-semibold mt-1.5 flex items-center gap-1.5';
      pwdLengthBadge.textContent = `${pVal.length}/6 chars`;
      pwdLengthBadge.className = 'text-[10px] font-bold text-rose-500';
    } else {
      pwdInput.classList.remove('border-rose-500', 'ring-rose-500/20');
      pwdInput.classList.add('border-emerald-500', 'ring-2', 'ring-emerald-500/20');
      pwdHint.innerHTML = '<i class="fa-solid fa-circle-check text-[10px] text-emerald-500"></i> Password length looks good';
      pwdHint.className = 'text-[11px] text-emerald-600 font-semibold mt-1.5 flex items-center gap-1.5';
      pwdLengthBadge.textContent = '✓ Strong';
      pwdLengthBadge.className = 'text-[10px] font-bold text-emerald-600';
    }

    // Confirm password match validation
    if (cpVal.length === 0) {
      confirmPwdInput.classList.remove('border-rose-500', 'border-emerald-500', 'ring-2', 'ring-rose-500/20', 'ring-emerald-500/20', 'bg-rose-50/30', 'bg-emerald-50/30');
      matchFeedback.innerHTML = '<p class="text-[11px] text-slate-500 flex items-center gap-1.5"><i class="fa-solid fa-shield-halved text-[10px]"></i> Re-enter password to verify</p>';
      matchStatusBadge.textContent = 'Match verification';
      matchStatusBadge.className = 'text-[10px] font-semibold text-slate-400';
    } else if (pVal !== cpVal) {
      // Passwords do not match
      confirmPwdInput.classList.add('border-rose-500', 'ring-2', 'ring-rose-500/20', 'bg-rose-50/20');
      confirmPwdInput.classList.remove('border-emerald-500', 'ring-emerald-500/20', 'bg-emerald-50/20');
      matchFeedback.innerHTML = `
        <p class="text-[11px] font-bold text-rose-600 flex items-center gap-1.5 animate-shake">
          <i class="fa-solid fa-circle-xmark text-rose-500"></i> Passwords do not match
        </p>
      `;
      matchStatusBadge.textContent = '✕ Mismatch';
      matchStatusBadge.className = 'text-[10px] font-bold text-rose-500';
    } else {
      // Passwords match
      confirmPwdInput.classList.remove('border-rose-500', 'ring-rose-500/20', 'bg-rose-50/20');
      confirmPwdInput.classList.add('border-emerald-500', 'ring-2', 'ring-emerald-500/20', 'bg-emerald-50/20');
      matchFeedback.innerHTML = `
        <p class="text-[11px] font-bold text-emerald-600 flex items-center gap-1.5">
          <i class="fa-solid fa-circle-check text-emerald-500"></i> Passwords match
        </p>
      `;
      matchStatusBadge.textContent = '✓ Matched';
      matchStatusBadge.className = 'text-[10px] font-bold text-emerald-600';
    }
  }

  pwdInput.addEventListener('input', checkPasswordMatch);
  confirmPwdInput.addEventListener('input', checkPasswordMatch);

  // Intercept form submission to prevent submission if validation fails
  regForm.addEventListener('submit', (e) => {
    const name = document.getElementById('name').value.trim();
    const email = document.getElementById('email').value.trim();
    const pVal = pwdInput.value;
    const cpVal = confirmPwdInput.value;

    clientAlert.classList.add('hidden');

    if (!name || !email || !pVal || !cpVal) {
      e.preventDefault();
      clientErrorMsg.textContent = 'Please fill in all required fields marked with an asterisk (*).';
      clientAlert.classList.remove('hidden');
      clientAlert.classList.add('animate-shake');
      setTimeout(() => clientAlert.classList.remove('animate-shake'), 500);
      return;
    }

    if (pVal.length < 6) {
      e.preventDefault();
      clientErrorMsg.textContent = 'Password must be at least 6 characters long.';
      clientAlert.classList.remove('hidden');
      pwdInput.focus();
      pwdInput.classList.add('animate-shake');
      setTimeout(() => pwdInput.classList.remove('animate-shake'), 500);
      return;
    }

    if (pVal !== cpVal) {
      e.preventDefault();
      clientErrorMsg.textContent = 'Passwords do not match. Please verify your passwords before submitting.';
      clientAlert.classList.remove('hidden');
      confirmPwdInput.focus();
      confirmPwdInput.classList.add('animate-shake');
      setTimeout(() => confirmPwdInput.classList.remove('animate-shake'), 500);
      return;
    }
  });
</script>

<%- include('../partials/footer') %>
