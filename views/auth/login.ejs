<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<div class="min-h-[calc(100vh-14rem)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-6">
    
    <!-- Header -->
    <div class="text-center space-y-2">
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-brand-600 to-accent-600 text-white flex items-center justify-center mx-auto shadow-lg shadow-brand-500/25">
        <i class="fa-solid fa-lock text-2xl"></i>
      </div>
      <h2 class="font-heading font-extrabold text-3xl text-slate-900 tracking-tight">
        <%= (typeof pendingBooking !== 'undefined' && pendingBooking) ? 'Sign In to Finalize Booking' : 'Welcome Back' %>
      </h2>
      <p class="text-xs text-slate-500 max-w-xs mx-auto">
        <%= (typeof pendingBooking !== 'undefined' && pendingBooking) ? 'Sign in to confirm your venue reservation and proceed to payment.' : 'Sign in to manage venue bookings, track event approvals, or access your workspace.' %>
      </p>
    </div>

    <!-- Pending Booking Reservation Alert Banner -->
    <% if (typeof pendingBooking !== 'undefined' && pendingBooking) { %>
      <div class="p-4 rounded-3xl bg-indigo-50 border-2 border-indigo-200 shadow-sm space-y-2 text-xs text-indigo-950 animate-fade-in">
        <div class="flex items-center justify-between">
          <span class="font-extrabold uppercase tracking-wider text-[10px] text-indigo-700 flex items-center gap-1.5">
            <i class="fa-solid fa-calendar-check text-indigo-600"></i> Finalize Your Venue Booking
          </span>
          <span class="font-extrabold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-md">$<%= pendingBooking.totalCost %></span>
        </div>
        <div class="space-y-0.5">
          <p class="font-bold text-slate-900 text-sm"><%= pendingBooking.eventTitle %></p>
          <p class="text-slate-600 font-medium">
            <i class="fa-solid fa-landmark text-[11px] mr-1 text-indigo-500"></i><%= pendingBooking.venueName %> &bull; 
            <i class="fa-regular fa-calendar text-[11px] mr-1 text-indigo-500"></i><%= pendingBooking.bookingDate %> (<%= pendingBooking.startTime %> - <%= pendingBooking.endTime %>)
          </p>
        </div>
        <p class="text-[11px] text-indigo-700 border-t border-indigo-100 pt-1.5">
          Sign in below or <a href="/auth/register" class="font-bold underline text-brand-700 hover:text-brand-900">create an account</a> to hold this slot for 15 minutes and proceed to payment.
        </p>
      </div>
    <% } %>

    <!-- Standard Login Form -->
    <div class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-sm space-y-6">
      <form action="/auth/login" method="POST" class="space-y-4">
        
        <div>
          <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Email Address
          </label>
          <div class="relative rounded-xl shadow-sm">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <i class="fa-regular fa-envelope text-sm"></i>
            </div>
            <input 
              type="email" 
              name="email" 
              id="email" 
              required
              value="<%= typeof email !== 'undefined' ? email : '' %>"
              placeholder="you@campus.edu"
              class="block w-full pl-10 pr-3.5 py-2.5 text-sm rounded-xl border border-slate-300 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition-colors"
            >
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="password" class="block text-xs font-bold uppercase tracking-wider text-slate-700">
              Password
            </label>
          </div>
          <div class="relative rounded-xl shadow-sm">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <i class="fa-solid fa-key text-sm"></i>
            </div>
            <input 
              type="password" 
              name="password" 
              id="password" 
              required
              placeholder="••••••••"
              class="block w-full pl-10 pr-10 py-2.5 text-sm rounded-xl border border-slate-300 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition-colors"
            >
            <button 
              type="button" 
              onclick="toggleLoginPassword()" 
              class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 focus:outline-none"
              tabindex="-1"
              title="Toggle password visibility"
            >
              <i class="fa-regular fa-eye text-sm" id="loginPwdToggleIcon"></i>
            </button>
          </div>
        </div>

        <button 
          type="submit" 
          class="w-full py-3 px-4 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-brand-600 to-accent-600 hover:from-brand-700 hover:to-accent-700 shadow-md shadow-brand-500/25 transition-all hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-brand-500/50 mt-2"
        >
          Sign In to Workspace &rarr;
        </button>

      </form>

      <div class="text-center pt-2 border-t border-slate-100">
        <p class="text-xs text-slate-500">
          New campus organiser? 
          <a href="/auth/register" class="font-bold text-brand-600 hover:text-brand-700 ml-1">Create an account</a>
        </p>
      </div>
    </div>

  </div>
</div>

<script>
  function toggleLoginPassword() {
    const input = document.getElementById('password');
    const icon = document.getElementById('loginPwdToggleIcon');
    if (input.type === 'password') {
      input.type = 'text';
      icon.className = 'fa-regular fa-eye-slash text-sm text-brand-600';
    } else {
      input.type = 'password';
      icon.className = 'fa-regular fa-eye text-sm text-slate-400';
    }
  }
</script>

<%- include('../partials/footer') %>
