<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="flex-grow py-10">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Profile Header Card -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm mb-8">
      <div class="flex flex-col sm:flex-row items-center gap-6">
        <div class="w-20 h-20 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-heading font-extrabold text-3xl border-2 border-emerald-300">
          <%= profileUser.name.charAt(0).toUpperCase() %>
        </div>
        <div class="text-center sm:text-left space-y-1">
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
            <h1 class="font-heading font-extrabold text-2xl text-slate-900"><%= profileUser.name %></h1>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold uppercase <%= profileUser.role === 'admin' ? 'bg-purple-100 text-purple-800' : (profileUser.role === 'ngo' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800') %>">
              <%= profileUser.role === 'ngo' ? 'NGO / Volunteer' : profileUser.role %>
            </span>
            <% if (profileUser.isVerified) { %>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                <i class="fa-solid fa-certificate text-emerald-500"></i> Verified
              </span>
            <% } %>
          </div>
          <p class="text-sm text-slate-600 font-medium"><%= profileUser.organizationName %> (<%= profileUser.organizationType %>)</p>
          <p class="text-xs text-slate-400">Member since <%= new Date(profileUser.createdAt).toLocaleDateString() %></p>
        </div>
      </div>
    </div>

    <!-- Edit Profile Form -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
      <h2 class="font-heading font-bold text-xl text-slate-900 mb-6 flex items-center gap-2">
        <i class="fa-solid fa-user-pen text-emerald-600"></i>
        <span>Account & Organization Details</span>
      </h2>

      <form action="/auth/profile" method="POST" class="space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Contact Name</label>
            <input type="text" name="name" value="<%= profileUser.name %>" required class="block w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Email Address (Read Only)</label>
            <input type="email" value="<%= profileUser.email %>" disabled class="block w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 bg-slate-100 text-slate-500 cursor-not-allowed">
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Phone Number</label>
            <input type="tel" name="phone" value="<%= profileUser.phone %>" required class="block w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Organization / Entity Name</label>
            <input type="text" name="organizationName" value="<%= profileUser.organizationName %>" class="block w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Primary Area / Locality</label>
            <input type="text" name="area" value="<%= profileUser.area %>" class="block w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Pincode</label>
            <input type="text" name="pincode" value="<%= profileUser.pincode %>" maxlength="6" class="block w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
          </div>

          <div class="sm:col-span-2">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Physical Pickup / HQ Address</label>
            <textarea name="address" rows="2" class="block w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"><%= profileUser.address %></textarea>
          </div>
        </div>

        <div class="flex justify-end pt-4 border-t border-slate-100">
          <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md shadow-emerald-600/20 transition-all">
            <i class="fa-solid fa-floppy-disk"></i>
            <span>Save Profile Updates</span>
          </button>
        </div>
      </form>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
