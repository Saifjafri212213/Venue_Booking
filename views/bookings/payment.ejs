<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-6">
  
  <!-- Flow Stepper Header -->
  <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 text-brand-700 text-xs font-bold mb-1">
          <i class="fa-solid fa-shield-halved"></i> Step 2 of 2: Secure Payment & Verification
        </div>
        <h1 class="font-heading font-extrabold text-2xl sm:text-3xl text-slate-900 tracking-tight">
          Complete Venue Booking Payment
        </h1>
        <p class="text-xs text-slate-500">
          Booking Reference: <span class="font-mono font-bold text-slate-800"><%= booking.bookingReference %></span> • <%= booking.eventTitle %>
        </p>
      </div>

      <!-- Live 15-Minute Countdown Timer Badge -->
      <div id="countdownCard" class="flex items-center gap-3 bg-slate-900 text-white p-3.5 rounded-2xl shadow-md self-start md:self-auto <%= (booking.paymentStatus === 'pending_verification' || booking.paymentStatus === 'paid') ? 'hidden' : '' %>">
        <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-lg animate-pulse">
          <i class="fa-regular fa-clock"></i>
        </div>
        <div>
          <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400 block">Slot Hold Window</span>
          <span id="timerDisplay" class="font-mono text-xl font-extrabold text-amber-400">15:00</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Expired Slot Banner (Hidden by default, shown when timer ends) -->
  <div id="timerExpiredAlert" class="hidden p-6 rounded-3xl bg-rose-50 border border-rose-200 text-rose-900 space-y-3 shadow-sm animate-fade-in">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center text-lg shrink-0">
        <i class="fa-solid fa-clock-rotate-left"></i>
      </div>
      <div>
        <h3 class="font-heading font-bold text-base text-rose-950">15-Minute Slot Hold Window Expired</h3>
        <p class="text-xs text-rose-700">
          This slot reservation hold has expired. To secure this slot again, click below to reactivate your payment window.
        </p>
      </div>
    </div>
    <div class="pt-2">
      <a href="/bookings/<%= booking._id %>/retry-payment" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 transition-colors shadow">
        <i class="fa-solid fa-rotate-right"></i> Reactivate 15-Min Payment Window
      </a>
    </div>
  </div>

  <!-- Rejection Alert (If payment was rejected by admin) -->
  <% if (booking.paymentStatus === 'rejected' || (booking.rejectionReason && booking.rejectionReason.length > 0)) { %>
    <div class="p-6 rounded-3xl bg-rose-50 border border-rose-200 text-rose-900 space-y-2 shadow-sm animate-fade-in">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center text-lg shrink-0">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <div>
          <h3 class="font-heading font-bold text-base text-rose-950">Payment Proof Rejected by Administrator</h3>
          <p class="text-xs text-rose-700">
            <strong>Reason:</strong> <%= booking.rejectionReason || 'Transaction could not be verified in institutional records.' %>
          </p>
        </div>
      </div>
      <p class="text-xs text-slate-600 pt-1">
        You can re-submit with the corrected Bank UTR / Transaction Reference number and payment screenshot below.
      </p>
    </div>
  <% } %>

  <!-- Main Grid: Payment Details & Proof Upload -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    
    <!-- Left Column: Bank Details & Dynamic UPI QR -->
    <div class="lg:col-span-7 space-y-6">
      
      <!-- Amount Card -->
      <div class="bg-gradient-to-br from-brand-900 via-indigo-900 to-slate-900 text-white rounded-3xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
        <div class="absolute -right-8 -bottom-8 w-40 h-40 bg-brand-500/20 rounded-full blur-2xl pointer-events-none"></div>
        <div class="flex items-center justify-between">
          <div>
            <span class="text-xs uppercase font-bold tracking-widest text-brand-300">Total Payable Amount</span>
            <div class="text-4xl sm:text-5xl font-extrabold font-heading mt-1 text-white">
              $<%= booking.totalCost %>
            </div>
            <p class="text-xs text-slate-300 mt-1">
              Rate: $<%= booking.hourlyRate %>/hr × <%= booking.durationHours %> hours
            </p>
          </div>
          <div class="w-16 h-16 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-2xl text-amber-400">
            <i class="fa-solid fa-receipt"></i>
          </div>
        </div>
      </div>

      <!-- Dynamic UPI QR Code & Instant Payment -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-sm space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-brand-100 text-brand-700 flex items-center justify-center text-sm font-bold">
              <i class="fa-solid fa-qrcode"></i>
            </div>
            <div>
              <h3 class="font-heading font-extrabold text-base text-slate-900">Instant UPI QR Code</h3>
              <p class="text-[11px] text-slate-500">Scan using Google Pay, PhonePe, Paytm, or any BHIM UPI app</p>
            </div>
          </div>
          <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
            Auto-Generated
          </span>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-6 justify-center bg-slate-50 p-6 rounded-2xl border border-slate-200/60">
          <!-- QR Image -->
          <div class="bg-white p-3.5 rounded-2xl shadow-md border border-slate-200 shrink-0">
            <% if (paymentSettings.customQrImage && paymentSettings.customQrImage.length > 0) { %>
              <img src="<%= paymentSettings.customQrImage %>" alt="Payment QR" class="w-48 h-48 sm:w-52 sm:h-52 object-contain mx-auto rounded-lg">
            <% } else if (dynamicQrCode && dynamicQrCode.length > 0) { %>
              <img src="<%= dynamicQrCode %>" alt="UPI Payment QR Code" class="w-48 h-48 sm:w-52 sm:h-52 object-contain mx-auto rounded-lg">
            <% } else { %>
              <div class="w-48 h-48 flex items-center justify-center text-slate-400 text-xs">
                QR Not Available
              </div>
            <% } %>
          </div>

          <!-- UPI ID Details & Deep Link -->
          <div class="space-y-3 text-center sm:text-left w-full">
            <div>
              <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">UPI ID / VPA</span>
              <div class="flex items-center justify-center sm:justify-start gap-2 mt-0.5">
                <span class="font-mono text-sm font-bold text-slate-800" id="upiIdText"><%= paymentSettings.upiId %></span>
                <button type="button" onclick="copyToClipboard('<%= paymentSettings.upiId %>', this)" class="p-1.5 rounded-lg text-slate-400 hover:text-brand-600 hover:bg-brand-50 transition-colors" title="Copy UPI ID">
                  <i class="fa-regular fa-copy text-xs"></i>
                </button>
              </div>
            </div>

            <div>
              <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Payee Name</span>
              <p class="text-xs font-semibold text-slate-700"><%= paymentSettings.accountHolderName %></p>
            </div>

            <% if (typeof upiUri !== 'undefined' && upiUri) { %>
              <a href="<%= upiUri %>" class="inline-flex items-center justify-center gap-1.5 w-full py-2.5 px-4 rounded-xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 shadow-sm transition-all sm:w-auto">
                <i class="fa-solid fa-mobile-screen-button"></i> Open UPI App
              </a>
            <% } %>
          </div>
        </div>

      </div>

      <!-- Bank Transfer Details Card -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-sm space-y-4">
        <div class="flex items-center gap-2.5 border-b border-slate-100 pb-3">
          <div class="w-8 h-8 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center text-sm">
            <i class="fa-solid fa-building-columns"></i>
          </div>
          <div>
            <h3 class="font-heading font-extrabold text-base text-slate-900">Direct Bank Account Transfer (NEFT / RTGS / IMPS)</h3>
            <p class="text-[11px] text-slate-500">Official campus administration banking details</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
            <div>
              <span class="text-[10px] uppercase font-bold text-slate-400 block">Account Holder</span>
              <span class="font-bold text-slate-800"><%= paymentSettings.accountHolderName %></span>
            </div>
          </div>

          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
            <div>
              <span class="text-[10px] uppercase font-bold text-slate-400 block">Bank Name</span>
              <span class="font-bold text-slate-800"><%= paymentSettings.bankName %></span>
            </div>
          </div>

          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
            <div>
              <span class="text-[10px] uppercase font-bold text-slate-400 block">Account Number</span>
              <span class="font-mono font-bold text-slate-900"><%= paymentSettings.accountNumber %></span>
            </div>
            <button type="button" onclick="copyToClipboard('<%= paymentSettings.accountNumber %>', this)" class="p-1 rounded-lg text-slate-400 hover:text-brand-600 hover:bg-brand-50" title="Copy Account Number">
              <i class="fa-regular fa-copy text-xs"></i>
            </button>
          </div>

          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
            <div>
              <span class="text-[10px] uppercase font-bold text-slate-400 block">IFSC Code</span>
              <span class="font-mono font-bold text-indigo-600"><%= paymentSettings.ifscCode %></span>
            </div>
            <button type="button" onclick="copyToClipboard('<%= paymentSettings.ifscCode %>', this)" class="p-1 rounded-lg text-slate-400 hover:text-brand-600 hover:bg-brand-50" title="Copy IFSC Code">
              <i class="fa-regular fa-copy text-xs"></i>
            </button>
          </div>

        </div>

        <div class="text-[11px] text-slate-500 bg-amber-50 p-3 rounded-xl border border-amber-200/60 flex items-start gap-2">
          <i class="fa-solid fa-circle-info text-amber-600 text-xs mt-0.5 shrink-0"></i>
          <span><%= paymentSettings.instructions %></span>
        </div>
      </div>

    </div>

    <!-- Right Column: Booking Summary & Payment Proof Form -->
    <div class="lg:col-span-5 space-y-6">
      
      <!-- Booking Overview Card -->
      <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm space-y-4">
        <h3 class="font-heading font-extrabold text-base text-slate-900 flex items-center gap-2">
          <i class="fa-solid fa-calendar-check text-brand-600 text-sm"></i> Booking Summary
        </h3>

        <!-- Venue Mini Card -->
        <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-100">
          <img 
            src="<%= booking.venue && booking.venue.featuredImage ? booking.venue.featuredImage : 'https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=400&q=80' %>" 
            alt="<%= booking.venue ? booking.venue.name : 'Venue' %>" 
            class="w-14 h-14 rounded-xl object-cover shrink-0"
          >
          <div class="min-w-0 flex-1">
            <h4 class="font-bold text-slate-900 text-sm truncate"><%= booking.venue ? booking.venue.name : 'Campus Venue' %></h4>
            <p class="text-[11px] text-slate-500 truncate"><%= booking.venue ? booking.venue.location : '' %></p>
            <span class="text-[10px] font-bold text-brand-600 font-mono"><%= booking.venue ? booking.venue.code : '' %></span>
          </div>
        </div>

        <div class="space-y-2 text-xs border-t border-slate-100 pt-3">
          <div class="flex items-center justify-between">
            <span class="text-slate-500">Date:</span>
            <span class="font-bold text-slate-800">
              <%= new Date(booking.bookingDate).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %>
            </span>
          </div>

          <div class="flex items-center justify-between">
            <span class="text-slate-500">Time Slot:</span>
            <span class="font-mono font-bold text-slate-800">
              <%= booking.startTime %> - <%= booking.endTime %> (<%= booking.durationHours %> hrs)
            </span>
          </div>

          <div class="flex items-center justify-between">
            <span class="text-slate-500">Expected Attendees:</span>
            <span class="font-bold text-slate-800"><%= booking.expectedAttendees %> People</span>
          </div>

          <div class="flex items-center justify-between border-t border-slate-100 pt-2 text-sm">
            <span class="font-bold text-slate-900">Total Booking Fee:</span>
            <span class="font-heading font-extrabold text-emerald-600 text-base">$<%= booking.totalCost %></span>
          </div>
        </div>
      </div>

      <!-- Payment Proof Submission Form -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-sm space-y-6">
        <div>
          <h3 class="font-heading font-extrabold text-lg text-slate-900">Submit Payment Proof</h3>
          <p class="text-xs text-slate-500 mt-0.5">
            Enter the transaction reference from your bank app to submit for verification.
          </p>
        </div>

        <form id="proofForm" action="/bookings/<%= booking._id %>/payment-proof" method="POST" enctype="multipart/form-data" class="space-y-4">
          
          <!-- UTR / Transaction Reference -->
          <div>
            <label for="utrNumber" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Bank UTR / UPI Ref ID *
            </label>
            <div class="relative rounded-xl">
              <input 
                type="text" 
                name="utrNumber" 
                id="utrNumber" 
                required
                value="<%= booking.utrNumber || '' %>"
                placeholder="e.g. 423981029384"
                class="block w-full px-3.5 py-2.5 text-sm font-mono uppercase rounded-xl border border-slate-300 placeholder:text-slate-400 placeholder:font-sans focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition-all"
              >
            </div>
            <p class="text-[10px] text-slate-400 mt-1">12-digit transaction ID generated by your bank or UPI payment app</p>
          </div>

          <!-- Screenshot Upload -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Payment Screenshot (Recommended)
            </label>
            
            <div 
              id="dropZone" 
              onclick="document.getElementById('paymentScreenshot').click()"
              class="border-2 border-dashed border-slate-300 hover:border-brand-500 rounded-2xl p-4 text-center cursor-pointer bg-slate-50 hover:bg-brand-50/30 transition-all"
            >
              <input 
                type="file" 
                name="paymentScreenshot" 
                id="paymentScreenshot" 
                accept="image/png, image/jpeg, image/jpg, image/webp" 
                class="hidden"
                onchange="previewScreenshot(this)"
              >
              
              <div id="uploadPrompt" class="space-y-1">
                <i class="fa-solid fa-cloud-arrow-up text-2xl text-slate-400"></i>
                <p class="text-xs font-semibold text-slate-700">Click to upload transfer screenshot</p>
                <p class="text-[10px] text-slate-400">PNG, JPG, or WEBP (Max 5MB)</p>
              </div>

              <!-- Image Preview -->
              <div id="imagePreviewContainer" class="hidden space-y-2">
                <img id="imagePreview" src="" alt="Payment Proof Preview" class="max-h-36 mx-auto rounded-lg border border-slate-200 object-contain">
                <p id="fileNameText" class="text-[10px] text-slate-600 font-mono"></p>
                <span class="text-[10px] font-bold text-brand-600 hover:underline">Change screenshot</span>
              </div>
            </div>

            <!-- Existing Screenshot if previously uploaded -->
            <% if (booking.paymentScreenshot && booking.paymentScreenshot.length > 0) { %>
              <div class="mt-2 text-[11px] text-slate-600 flex items-center justify-between p-2 rounded-xl bg-slate-100 border border-slate-200">
                <span class="flex items-center gap-1.5"><i class="fa-solid fa-paperclip text-slate-400"></i> Current proof on record</span>
                <a href="<%= booking.paymentScreenshot %>" target="_blank" class="font-bold text-brand-600 hover:underline">View Proof &rarr;</a>
              </div>
            <% } %>
          </div>

          <button 
            id="submitProofBtn"
            type="submit" 
            class="w-full py-3.5 px-4 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-brand-600 to-accent-600 hover:from-brand-700 hover:to-accent-700 shadow-lg shadow-brand-500/25 transition-all hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-brand-500/50 flex items-center justify-center gap-2"
          >
            <i class="fa-solid fa-circle-check"></i> Submit Verification Proof &rarr;
          </button>

        </form>
      </div>

    </div>

  </div>

</div>

<script>
  // Countdown Timer Script
  let remainingSeconds = <%= remainingSeconds || 900 %>;
  const timerDisplay = document.getElementById('timerDisplay');
  const timerExpiredAlert = document.getElementById('timerExpiredAlert');
  const countdownCard = document.getElementById('countdownCard');
  const submitProofBtn = document.getElementById('submitProofBtn');

  function updateTimer() {
    if (remainingSeconds <= 0) {
      if (timerDisplay) timerDisplay.textContent = '00:00';
      if (timerExpiredAlert) timerExpiredAlert.classList.remove('hidden');
      if (countdownCard) countdownCard.classList.add('bg-rose-900');
      return;
    }

    remainingSeconds--;
    const mins = Math.floor(remainingSeconds / 60);
    const secs = remainingSeconds % 60;
    const formatted = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    if (timerDisplay) timerDisplay.textContent = formatted;
  }

  setInterval(updateTimer, 1000);

  // 1-Click Copy Helper
  function copyToClipboard(text, btnElement) {
    navigator.clipboard.writeText(text).then(() => {
      const originalHtml = btnElement.innerHTML;
      btnElement.innerHTML = '<i class="fa-solid fa-check text-xs text-emerald-600"></i>';
      setTimeout(() => {
        btnElement.innerHTML = originalHtml;
      }, 1500);
    }).catch(err => {
      console.error('Could not copy text: ', err);
    });
  }

  // Screenshot Upload Preview
  function previewScreenshot(input) {
    if (input.files && input.files[0]) {
      const file = input.files[0];
      const reader = new FileReader();

      reader.onload = function(e) {
        document.getElementById('imagePreview').src = e.target.result;
        document.getElementById('fileNameText').textContent = file.name;
        document.getElementById('uploadPrompt').classList.add('hidden');
        document.getElementById('imagePreviewContainer').classList.remove('hidden');
      };

      reader.readAsDataURL(file);
    }
  }
</script>

<%- include('../partials/footer') %>
